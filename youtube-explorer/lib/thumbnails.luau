--!nonstrict
local records = require("./records.luau")
local scheduler = require("./scheduler.luau")
local Module = {}

function Module.new(dataDir, getPage, onChanged)
    local M = {}
    local validId = records.validId
    local downloading = {}
    local thumbnailQueue, queueIndex, activeDownloads = {}, 1, 0
    local requestedItems, states, validated = {}, {}, {}
    local cacheGeneration = 0
    local lastCleanup, cleaning = nil, false
    local CLEANUP_INTERVAL_MS = 15 * 60 * 1000
    -- Keep image traffic bounded while browsing.
    local MAX_DOWNLOADS, MAX_IMAGE_BYTES = 3, 1024 * 1024
    local cacheDir = dataDir and (dataDir .. "/thumbnails") or nil
    if cacheDir and not noctalia.mkdirAll(cacheDir) then cacheDir = nil end
    local function clearThumbnailCache()
        cacheGeneration = cacheGeneration + 1
        for _, state in pairs(states) do scheduler.cancel(state.timer) end
        states, validated = {}, {}
        thumbnailQueue, queueIndex = {}, 1
        if not cacheDir then noctalia.notifyError(noctalia.tr("error.cache_unavailable")); return false end
        local names = noctalia.listDir(cacheDir)
        if not names then noctalia.notifyError(noctalia.tr("error.cache_read")); return false end
        local failed = false
        for _, name in ipairs(names) do
            -- Only delete files generated by this plugin, including unfinished writes.
            local base = name:gsub("%.part$", "")
            local video = base:match("^video%-([A-Za-z0-9_-]+)%.jpg$")
            local channel = base:match("^channel%-([A-Za-z0-9_-]+)%.jpg$")
            if validId(video, false) or validId(channel, true) then
                if not noctalia.removeFile(cacheDir .. "/" .. name) then failed = true end
            end
        end
        if failed then noctalia.notifyError(noctalia.tr("error.cache_remove"))
        else noctalia.notify(noctalia.tr("notice.cache_cleared")) end
        return not failed
    end
    local function validImage(body)
        if type(body) ~= "string" or #body < 12 or #body > MAX_IMAGE_BYTES then return false end
        return body:sub(1, 3) == string.char(255, 216, 255)
            or body:sub(1, 8) == "\137PNG\r\n\26\n"
            or (body:sub(1, 4) == "RIFF" and body:sub(9, 12) == "WEBP")
    end
    local function cached(path)
        if not noctalia.fileExists(path) then validated[path] = nil; return false end
        if validated[path] ~= nil then return validated[path] end
        validated[path] = validImage(noctalia.readFile(path))
        if not validated[path] then noctalia.removeFile(path) end
        return validated[path]
    end
    local function saveThumbnail(path, response)
        if not response.ok or response.status ~= 200 or not validImage(response.body) then return false, false end
        local temporary = path .. ".part"
        if noctalia.writeFile(temporary, response.body) and noctalia.renameFile(temporary, path) then
            validated[path] = true
            return true
        end
        noctalia.removeFile(temporary)
        return false, true
    end
    local pumpThumbnails, requestThumbnails
    local function cleanCache(items)
        local now = noctalia.nowMs()
        if cleaning or (lastCleanup and now >= lastCleanup and now - lastCleanup < CLEANUP_INTERVAL_MS)
            or not noctalia.commandExists("python3") then return end
        local protected, seen = {}, {}
        local function protect(key)
            if not seen[key] then
                seen[key] = true
                table.insert(protected, key .. ".jpg")
            end
        end
        for _, item in ipairs(items) do protect(item.key) end
        for key in pairs(downloading) do protect(key) end
        local body = #protected == 0 and "[]" or noctalia.json.encode(protected)
        local pluginDir = noctalia.pluginDir()
        if not body or not pluginDir then return end
        cleaning, lastCleanup = true, now
        local started = noctalia.runAsync({"python3", pluginDir .. "/helpers/thumbnail-cache.py", cacheDir, body},
            function(result)
                cleaning = false
                -- A page may have changed while cleanup ran; restore any newly needed image.
                if result.exitCode == 0 and getPage() then requestThumbnails() end
            end, 15000)
        if not started then cleaning = false end
    end
    local function retry(job, transient)
        local state = job.state
        if states[job.key] ~= state or job.cacheGeneration ~= cacheGeneration then return end
        if not transient or state.attempts >= 3 then state.blocked = true; return end
        state.due = noctalia.nowMs() + (state.attempts == 1 and 2000 or 5000)
        scheduler.cancel(state.timer)
        state.timer = scheduler.after(state.due - noctalia.nowMs(), function()
            if states[job.key] == state and getPage() then requestThumbnails() end
        end)
    end
    pumpThumbnails = function()
        while activeDownloads < MAX_DOWNLOADS and queueIndex <= #thumbnailQueue do
            local job = thumbnailQueue[queueIndex]
            queueIndex = queueIndex + 1
            local state = job.state
            if states[job.key] == state and not state.blocked and not cached(job.path)
                and not downloading[job.key] and (not state.due or noctalia.nowMs() >= state.due) then
                downloading[job.key] = true
                activeDownloads = activeDownloads + 1
                state.attempts = state.attempts + 1
                local finished, watchdog = false, nil
                local function response(result)
                    if finished then return end
                    finished = true
                    scheduler.cancel(watchdog)
                    downloading[job.key] = nil
                    activeDownloads = activeDownloads - 1
                    local ok, storageError = false, false
                    if job.cacheGeneration == cacheGeneration
                        and (not states[job.key] or states[job.key].url == job.url) then
                        ok, storageError = saveThumbnail(job.path, result)
                    end
                    if not ok then
                        local status = result.status or 0
                        local transient = not storageError and (status == 0 or status == 408
                            or status == 429 or status >= 500 or status == 200)
                        retry(job, transient)
                    end
                    if ok and getPage() then onChanged() end
                    if (job.cacheGeneration ~= cacheGeneration or (states[job.key] and states[job.key] ~= state))
                        and getPage() then requestThumbnails()
                    else pumpThumbnails() end
                end
                watchdog = scheduler.after(15000, function() response({ok = false, status = 0}) end)
                if not noctalia.http({url = job.url, follow_redirects = false}, response) then
                    response({ok = false, status = 0})
                end
            end
        end
    end
    requestThumbnails = function(items)
        thumbnailQueue, queueIndex = {}, 1
        if not cacheDir or not getPage() then return end
        items = items or getPage().items or requestedItems
        requestedItems = items
        cleanCache(items)
        local wanted = {}
        for _, item in ipairs(items) do
            local path = cacheDir .. "/" .. item.key .. ".jpg"
            local state = states[item.key]
            if not state or state.url ~= item.image then
                if state then scheduler.cancel(state.timer) end
                state = {url = item.image, attempts = 0}
            end
            wanted[item.key] = state
            if item.image and not cached(path) and not downloading[item.key] then
                table.insert(thumbnailQueue, {key = item.key, url = item.image, path = path,
                    cacheGeneration = cacheGeneration, state = state})
            end
        end
        for key, state in pairs(states) do if wanted[key] ~= state then scheduler.cancel(state.timer) end end
        states = wanted
        pumpThumbnails()
    end

    M.clear, M.pump, M.request = clearThumbnailCache, pumpThumbnails, requestThumbnails
    function M.cancel()
        for _, state in pairs(states) do scheduler.cancel(state.timer) end
        thumbnailQueue, queueIndex, requestedItems, states = {}, 1, {}, {}
    end
    function M.path(key)
        local path = cacheDir and (cacheDir .. "/" .. key .. ".jpg")
        return path and cached(path) and path or nil
    end
    return M
end

return Module
