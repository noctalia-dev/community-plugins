--!nonstrict
-- Shared display model for the panel and the arrange window.
--
-- Reading is `umbriel outputs --json`, the compositor's own view of the
-- wlr-output-management heads. Writing is [output.*] sections in a config
-- include: Umbriel re-registers its inotify watch over the whole include set
-- after every reload, so the file is both how a change lands and how it
-- survives a reboot. Nothing here sends a protocol configure request, since a
-- runtime change would drift from the file the next reload reads.

local HEADER = {
  "# Generated by the Noctalia umbriel-displays plugin. Rewritten on every change.",
  "# Included from config.toml, which must not declare [output.*] of its own:",
  "# values in an including file override every include.",
}
local QUERY_TIMEOUT_MS = 5000

local M = {}

-- ── Identity ───────────────────────────────────────────────────────────────

-- Settings belong to the monitor, not the port a dock happened to give it.
-- Umbriel matches "<make> <model> <serial>" with "Unknown" filling a blank
-- field, so only two displays are connector-only: one reporting none of the
-- three, and identical twins, which would otherwise share a single name.
function M.identityKey(output, siblings)
  if output.make == "" and output.model == "" and output.serial == "" then
    return output.name
  end
  for _, other in ipairs(siblings or {}) do
    if other.name ~= output.name and other.configName == output.configName then
      return output.name
    end
  end
  return output.configName
end

local function needsQuoting(key)
  return string.match(key, "^[A-Za-z0-9_-]+$") == nil
end

-- ── Modes ──────────────────────────────────────────────────────────────────

function M.resolutionOf(mode)
  return string.format("%dx%d", mode.width, mode.height)
end

-- Trailing zeros make 60.000 and 143.997 line up in a select, but Umbriel
-- parses the mode string, so it gets the trimmed form.
function M.hzLabel(mode)
  local text = string.gsub(string.format("%.3f", mode.refreshMhz / 1000), "%.?0+$", "")
  return text
end

function M.modeString(mode)
  return string.format("%dx%d@%s", mode.width, mode.height, M.hzLabel(mode))
end

function M.resolutions(output)
  local seen, list = {}, {}
  for _, mode in ipairs(output.modes) do
    local res = M.resolutionOf(mode)
    if not seen[res] then
      seen[res] = true
      table.insert(list, { res = res, pixels = mode.width * mode.height })
    end
  end
  table.sort(list, function(a, b) return a.pixels > b.pixels end)
  return list
end

function M.refreshRates(output, res)
  local seen, list = {}, {}
  for _, mode in ipairs(output.modes) do
    if M.resolutionOf(mode) == res then
      local hz = M.hzLabel(mode)
      if not seen[hz] then
        seen[hz] = true
        table.insert(list, { label = hz, mode = mode })
      end
    end
  end
  table.sort(list, function(a, b) return a.mode.refreshMhz > b.mode.refreshMhz end)
  return list
end

function M.findMode(output, res, hz)
  local fallback = nil
  for _, mode in ipairs(output.modes) do
    if M.resolutionOf(mode) == res then
      if M.hzLabel(mode) == hz then
        return mode
      end
      if fallback == nil or mode.refreshMhz > fallback.refreshMhz then
        fallback = mode
      end
    end
  end
  return fallback
end

-- A rotated panel presents its modes untransformed, so the logical box the
-- layout occupies swaps axes while the mode string does not.
function M.logicalSize(output)
  local mode = output.currentMode
  if mode == nil then
    return 0, 0
  end
  local scale = output.scale > 0 and output.scale or 1.0
  local w, h = mode.width / scale, mode.height / scale
  if output.transform == "90" or output.transform == "270"
    or output.transform == "flipped-90" or output.transform == "flipped-270" then
    return h, w
  end
  return w, h
end

-- ── Reading ────────────────────────────────────────────────────────────────

local function parseOutputs(raw)
  local decoded, err = noctalia.json.decode(raw)
  if type(decoded) ~= "table" then
    noctalia.log("umbriel-displays: cannot parse umbriel outputs: " .. tostring(err))
    return nil
  end

  local parsed = {}
  for _, entry in ipairs(decoded) do
    local modes, current = {}, nil
    for _, mode in ipairs(entry.modes or {}) do
      local converted = {
        width = mode.width,
        height = mode.height,
        refreshMhz = mode.refresh_mhz or 0,
        preferred = mode.preferred == true,
      }
      table.insert(modes, converted)
      if mode.current == true then
        current = converted
      end
    end
    table.insert(parsed, {
      name = entry.name or "",
      configName = entry.config_name or "",
      description = entry.description or "",
      make = entry.make or "",
      model = entry.model or "",
      serial = entry.serial or "",
      enabled = entry.enabled == true,
      scale = tonumber(entry.scale) or 1.0,
      transform = entry.transform or "normal",
      x = entry.position and entry.position.x or 0,
      y = entry.position and entry.position.y or 0,
      modes = modes,
      currentMode = current or modes[1],
    })
  end
  table.sort(parsed, function(a, b) return a.name < b.name end)
  for _, entry in ipairs(parsed) do
    entry.key = M.identityKey(entry, parsed)
  end
  return parsed
end

function M.query(onDone)
  return noctalia.runAsync("umbriel outputs --json", function(result)
    onDone(result.exitCode == 0 and parseOutputs(result.stdout) or nil)
  end, QUERY_TIMEOUT_MS)
end

-- ── The include file ───────────────────────────────────────────────────────

function M.path()
  local configured = noctalia.getConfig("outputs_path")
  if type(configured) ~= "string" or configured == "" then
    return nil
  end
  return noctalia.expandPath(configured)
end

-- Only the shape this file writes: a section header, then `key = value` lines.
-- Values stay as their source text so a key the plugin does not manage, a
-- min_workspaces floor or a vrr mode, survives being rewritten.
function M.read()
  local path = M.path()
  if path == nil or not noctalia.fileExists(path) then
    return {}
  end
  local contents = noctalia.readFile(path)
  if contents == nil then
    return {}
  end

  local sections, key = {}, nil
  for line in string.gmatch(contents .. "\n", "(.-)\n") do
    local trimmed = noctalia.string.trim(line)
    local header = string.match(trimmed, '^%[output%.(.+)%]$')
    if header ~= nil then
      key = string.match(header, '^"(.*)"$') or header
      sections[key] = sections[key] or {}
    elseif key ~= nil and trimmed ~= "" and string.sub(trimmed, 1, 1) ~= "#" then
      local field, value = string.match(trimmed, "^([A-Za-z0-9_.]+)%s*=%s*(.+)$")
      if field ~= nil then
        sections[key][field] = value
      end
    end
  end
  return sections
end

-- Write order only. Every other key the file carries is preserved after these,
-- so a hand-written setting this plugin has no control for still survives.
local MANAGED = {
  "enabled", "mode", "position", "scale", "transform",
  "vrr", "tearing", "direct_scanout", "hdr", "sdr_white",
  "workspaces", "min_workspaces", "workspace_axis",
  "layout.scrolling.default_width_fraction",
}

local function render(sections)
  local keys = {}
  for key in pairs(sections) do
    table.insert(keys, key)
  end
  table.sort(keys)

  local lines = { table.concat(HEADER, "\n"), "" }
  for _, key in ipairs(keys) do
    local fields = sections[key]
    local name = needsQuoting(key) and string.format('%q', key) or key
    table.insert(lines, string.format("[output.%s]", name))

    local written = {}
    for _, field in ipairs(MANAGED) do
      if fields[field] ~= nil then
        table.insert(lines, string.format("%s = %s", field, fields[field]))
        written[field] = true
      end
    end
    local extras = {}
    for field in pairs(fields) do
      if not written[field] then
        table.insert(extras, field)
      end
    end
    table.sort(extras)
    for _, field in ipairs(extras) do
      table.insert(lines, string.format("%s = %s", field, fields[field]))
    end
    table.insert(lines, "")
  end

  return table.concat(lines, "\n")
end

-- The compositor is the authority on what its own config accepts, and it will
-- say so without being asked to reload: a key this Umbriel is too old for names
-- itself here instead of landing in the live file and warning afterwards.
local function diagnose(result)
  local first = string.match(result.stderr or "", "[^\n]+") or string.match(result.stdout or "", "[^\n]+") or ""
  local path = string.match(first, "unknown key%s+(.+)$")
  if path == nil then
    return first, nil
  end
  return first, string.match(path, "([^.]+)$") or path
end

-- Validated before it lands. The candidate sits beside the real file, which is
-- watched by name, so writing it disturbs nothing.
function M.write(sections, onDone)
  local path = M.path()
  if path == nil then
    onDone(false, "no outputs path configured")
    return
  end

  local candidate = path .. ".new"
  local ok, err = noctalia.writeFile(candidate, render(sections))
  if not ok then
    onDone(false, tostring(err))
    return
  end

  noctalia.runAsync({ "umbriel", "validate", "-c", candidate }, function(result)
    if result.exitCode == 0 then
      local moved, moveErr = noctalia.renameFile(candidate, path)
      onDone(moved, moveErr)
      return
    end
    noctalia.removeFile(candidate)
    local message, unsupported = diagnose(result)
    onDone(false, message, unsupported)
  end, QUERY_TIMEOUT_MS)
end

-- Lays an arrangement into freshly read sections: a placed output gets its
-- position and loses `enabled = false`, everything else is marked off. The
-- second return says whether any of that differed from the file, which is what
-- keeps the watchdog from writing on every output event it causes.
function M.apply(outputs, rows)
  local sections = M.read()
  local places = M.positions(rows)
  local changed = false

  local function set(section, field, value)
    if section[field] ~= value then
      section[field] = value
      changed = true
    end
  end

  for _, output in ipairs(outputs) do
    local section, moved = M.sectionFor(sections, output)
    changed = changed or moved == true
    local place = places[output.name]
    if place == nil then
      set(section, "enabled", "false")
    else
      set(section, "position", string.format("[%d, %d]", place.x, place.y))
      set(section, "enabled", nil)
    end
  end
  return sections, changed
end

-- A section already in the file is reused rather than shadowed by a second one
-- for the same display, which Umbriel would then prefer. When that section sits
-- under a connector and the display has a name of its own, it moves: a port is
-- what a dock reshuffles, so leaving it there is leaving the settings on the
-- port instead of on the monitor.
function M.sectionFor(sections, output)
  local key = output.key
  if sections[key] ~= nil then
    return sections[key]
  end

  for _, stale in ipairs({ output.configName, output.name }) do
    if stale ~= key and sections[stale] ~= nil then
      sections[key] = sections[stale]
      sections[stale] = nil
      -- The move is itself a change to write, or the file keeps the old key
      -- until something else happens to need saving.
      return sections[key], true
    end
  end

  sections[key] = {}
  return sections[key]
end

-- Values are kept as their source text, so a string round-trips with its quotes
-- and a number without.
function M.text(value)
  if value == nil then
    return nil
  end
  return string.match(value, '^"(.*)"$') or value
end

function M.quoted(value)
  return string.format("%q", value)
end

-- ── Arrangement ────────────────────────────────────────────────────────────

-- Rows are reconstructed from the positions Umbriel reports rather than kept as
-- plugin state: the config file stays the single source of truth, and a display
-- placed by hand or auto-placed on hotplug lands in the right row.
function M.rows(outputs)
  local placed = {}
  for _, output in ipairs(outputs) do
    if output.enabled and output.currentMode ~= nil then
      table.insert(placed, output)
    end
  end
  table.sort(placed, function(a, b)
    if a.y ~= b.y then
      return a.y < b.y
    end
    if a.x ~= b.x then
      return a.x < b.x
    end
    return a.name < b.name
  end)

  local rows, current, currentY = {}, nil, nil
  for _, output in ipairs(placed) do
    if current == nil or output.y ~= currentY then
      current = {}
      currentY = output.y
      table.insert(rows, current)
    end
    table.insert(current, output)
  end
  return rows
end

-- Every arrangement this window can express is edge to edge, so positions are a
-- running sum: no overlap to resolve and no gap to close.
function M.positions(rows)
  local placements, y = {}, 0
  for _, row in ipairs(rows) do
    local x, tallest = 0, 0
    for _, output in ipairs(row) do
      local w, h = M.logicalSize(output)
      placements[output.name] = { x = math.floor(x + 0.5), y = math.floor(y + 0.5) }
      x = x + w
      tallest = math.max(tallest, h)
    end
    y = y + tallest
  end
  return placements
end

-- Dropping a screen onto another trades their places. A rectangle is the one
-- target a drag cannot miss, since the ghost the pointer carries is itself a
-- rectangle and hides any thin slot underneath it.
function M.swap(rows, moved, anchor)
  local from, to = nil, nil
  for r, row in ipairs(rows) do
    for i, output in ipairs(row) do
      if output.name == moved.name then
        from = { r = r, i = i }
      elseif output.name == anchor then
        to = { r = r, i = i }
      end
    end
  end
  if to == nil then
    return rows
  end
  -- Dragged in from the tray, so there is nothing to trade with: land beside
  -- the anchor rather than evicting it.
  if from == nil then
    table.insert(rows[to.r], to.i + 1, moved)
    return rows
  end
  rows[from.r][from.i], rows[to.r][to.i] = rows[to.r][to.i], rows[from.r][from.i]
  return rows
end

-- `slot` names the neighbour to land against: "left|<name>" and "right|<name>"
-- join that screen's row, "above|<name>" and "below|<name>" open a row around
-- it. It anchors on a name because removing the dragged screen can empty its
-- row, which shifts every row index below it.
function M.move(rows, moved, slot)
  local kind, anchor = string.match(slot, "^([a-z]+)|(.+)$")

  -- Dropping a screen on a slot anchored to itself asks for where it already
  -- is. Beside itself is always a no-op; above or below itself only when it is
  -- alone in its row, since otherwise it is asking to split out of one.
  if kind ~= nil and anchor == moved.name then
    for _, row in ipairs(rows) do
      for _, output in ipairs(row) do
        if output.name == moved.name then
          if kind == "left" or kind == "right" or #row == 1 then
            return rows
          end
        end
      end
    end
  end

  for r = #rows, 1, -1 do
    for i = #rows[r], 1, -1 do
      if rows[r][i].name == moved.name then
        table.remove(rows[r], i)
      end
    end
    if #rows[r] == 0 then
      table.remove(rows, r)
    end
  end

  if kind == nil then
    return rows
  end

  local targetRow, targetIndex = nil, nil
  for r, row in ipairs(rows) do
    for i, output in ipairs(row) do
      if output.name == anchor then
        targetRow, targetIndex = r, i
      end
    end
  end

  -- The anchor left with the drag, so there is nothing to land against.
  if targetRow == nil then
    table.insert(rows, { moved })
    return rows
  end

  if kind == "above" then
    table.insert(rows, targetRow, { moved })
  elseif kind == "below" then
    table.insert(rows, targetRow + 1, { moved })
  elseif kind == "right" then
    table.insert(rows[targetRow], targetIndex + 1, moved)
  else
    table.insert(rows[targetRow], targetIndex, moved)
  end
  return rows
end

return M
