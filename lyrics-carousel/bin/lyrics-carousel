    try:
        import tomli as tomllib
    except ImportError:
        tomllib = None
import urllib.error
import urllib.parse
import urllib.request

APP = "lyrics-carousel"
VERSION = "2.5.0"

# Timeout of the lyrics lookup (seconds). The providers are slow: with 4 s a
# lyrics file that takes 6 s was thrown away.
SEARCH_TIMEOUT = 15.0
# How often a song without lyrics is retried (seconds).
RETRY_SECONDS = 60
# Grace period, after the first lyrics, for a version with word timings to
# arrive: the first one is shown right away and improved when it appears.
WORD_GRACE = 3.0
# How long a song without a word-timed version is remembered, so the lookup
# is not repeated on every playback (hours).
WORD_CHECK_HOURS = 24 * 7

# realpath: the script is launched through the symlink in ~/.local/bin. With
# abspath the directory would be ~/.local/bin and the sibling modules
# (image_renderer, graphics) would not be found: image mode would silently
# fall back to text mode.
_HERE = os.path.dirname(os.path.realpath(__file__))
if _HERE not in sys.path:
    sys.path.insert(0, _HERE)

IMAGE_ERROR = ""
try:
    from image_renderer import IMAGE_FPS, MOTION_FPS  # noqa: F401  (image mode frame rate)
except Exception:  # noqa: BLE001
    # The module may be missing (no Pillow): image mode is switched off and
    # the frame rate stays at the one image_renderer uses when it is there.
    IMAGE_FPS = 30
    MOTION_FPS = 60
try:
    from image_renderer import ImageRenderer
except Exception as error:  # noqa: BLE001  (image mode is optional)
    ImageRenderer = None
    IMAGE_ERROR = repr(error)

# The state paths (settings.toml and overrides) live in their own module:
# the script and the helper have to look in the same place, otherwise one
# would write where the other reads.
from paths import (  # noqa: E402
