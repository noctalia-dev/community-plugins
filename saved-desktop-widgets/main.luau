--!nonstrict
-- main.luau: Background service for Saved Desktop Widgets

local saveWidgets = noctalia.getConfig("saveWidgets")
if saveWidgets == nil then saveWidgets = true end

local loadWidgets = noctalia.getConfig("loadWidgets")
if loadWidgets == nil then loadWidgets = true end

local monitorWidgets = noctalia.state.get("monitorWidgets")
if monitorWidgets == nil then
  local dataDir = noctalia.pluginDataDir()
  if dataDir then
    local jsonStr = noctalia.readFile(dataDir .. "/layouts.json")
    if jsonStr then
      monitorWidgets = noctalia.json.decode(jsonStr)
    end
  end
  if type(monitorWidgets) ~= "table" then monitorWidgets = {} end
  noctalia.state.set("monitorWidgets", monitorWidgets)
end

noctalia.state.watch("saveWidgets", function(value) saveWidgets = value end)
noctalia.state.watch("loadWidgets", function(value) loadWidgets = value end)
noctalia.state.watch("monitorWidgets", function(value) monitorWidgets = value end)

local function tomlKey(key)
  if key:match("^[%a_][%w_%-]*$") then return key end
  return '"' .. key:gsub('\\', '\\\\'):gsub('"', '\\"') .. '"'
end

local function tomlString(v)
  return '"' .. v:gsub('\\', '\\\\'):gsub('"', '\\"'):gsub('\n', '\\n'):gsub('\r', '\\r'):gsub('\t', '\\t') .. '"'
end

local function tomlScalar(v)
  local t = type(v)
  if t == "string" then return tomlString(v) end
  if t == "boolean" then return tostring(v) end
  if t == "number" then
    if v == math.floor(v) and math.abs(v) < 2 ^ 53 then return string.format("%d", v) end
    return string.format("%.15g", v)
  end
  return nil
end

local function isScalarArray(t)
  local n = 0
  for k, v in pairs(t) do
    if type(k) ~= "number" or type(v) == "table" then return false end
    n = n + 1
  end
  for i = 1, n do if t[i] == nil then return false end end
  return n > 0, n
end

local function emitTable(tbl, path, out)
  local scalarLines, subTables = {}, {}
  for k, v in pairs(tbl) do
    if type(v) == "table" then
      local isArray, n = isScalarArray(v)
      if isArray then
        local parts = {}
        for i = 1, n do parts[i] = tomlScalar(v[i]) end
        scalarLines[#scalarLines + 1] = string.format("%s = [%s]", tomlKey(k), table.concat(parts, ", "))
      else
        subTables[#subTables + 1] = k
      end
    else
      local s = tomlScalar(v)
      if s then scalarLines[#scalarLines + 1] = string.format("%s = %s", tomlKey(k), s) end
    end
  end
  table.sort(scalarLines)
  table.sort(subTables)

  if #scalarLines > 0 or #subTables == 0 then
    out[#out + 1] = "[" .. path .. "]"
    for _, line in ipairs(scalarLines) do out[#out + 1] = line end
  end
  for _, k in ipairs(subTables) do
    out[#out + 1] = ""
    emitTable(tbl[k], path .. "." .. tomlKey(k), out)
  end
end

local function serializeDesktopWidgets(saved, current)
  local merged = {}
  for k, v in pairs(current or {}) do merged[k] = v end
  if saved.widget_order ~= nil then merged.widget_order = saved.widget_order end
  if saved.widget ~= nil then merged.widget = saved.widget end
  if saved.enabled ~= nil then merged.enabled = saved.enabled end

  local out = { "# Auto-generated by Saved Desktop Widgets Plugin", "" }
  emitTable(merged, "desktop_widgets", out)
  return table.concat(out, "\n") .. "\n"
end

local function injectLayoutIntoStateFile(tomlContent)
  local statePath = noctalia.expandPath("~/.local/state/noctalia/settings.toml")
  local existingState = ""
  local contents = noctalia.readFile(statePath)
  
  if contents then
    noctalia.writeFile(noctalia.expandPath("~/.local/state/noctalia/settings.toml.bak"), contents)
    
    local inDesktopWidgets = false
    for line in string.gmatch(contents, "[^\r\n]+") do
      if string.match(line, "^%[desktop_widgets") then
        inDesktopWidgets = true
      elseif string.match(line, "^%[") then
        inDesktopWidgets = false
      end
      
      if not inDesktopWidgets then
        existingState = existingState .. line .. "\n"
      end
    end
  end

  local newState = existingState .. "\n" .. tomlContent
  noctalia.mkdirAll(noctalia.expandPath("~/.local/state/noctalia"))
  return noctalia.writeFile(statePath, newState)
end

local lastWallpaper = ""
local lastLayoutStr = ""
local initialized = false

noctalia.setUpdateInterval(1000)

function update()
  local output = noctalia.focusedOutputName()
  if not output then
    local outputs = noctalia.outputs()
    if outputs and #outputs > 0 then
      output = outputs[1].name
    else return end
  end
  
  local currentWallpaper = noctalia.wallpaperPath(output)
  if not currentWallpaper then return end

  local currentLayout = noctalia.getSetting("desktop_widgets")
  local currentLayoutStr = noctalia.json.encode(currentLayout) or ""

  local dataDir = noctalia.pluginDataDir()

  -- Initialize baseline on first tick to prevent instant false-positive saves
  if not initialized then
    lastWallpaper = currentWallpaper
    lastLayoutStr = currentLayoutStr
    initialized = true
    return
  end

  -- 1. Handle Wallpaper Changes
  if currentWallpaper ~= lastWallpaper then
    if loadWidgets and monitorWidgets[currentWallpaper] then
      noctalia.notify(noctalia.tr("service.title"), noctalia.tr("service.applying"))

      local current = noctalia.getSetting("desktop_widgets") or {}
      local tomlContent = serializeDesktopWidgets(monitorWidgets[currentWallpaper], current)
      
      local success, err = injectLayoutIntoStateFile(tomlContent)
      if success then
        noctalia.notify(noctalia.tr("service.title"), noctalia.tr("service.applied"))
      else
        noctalia.notify(noctalia.tr("service.error_title"), noctalia.tr("service.failed") .. ": " .. tostring(err))
      end
    else
      noctalia.notify(noctalia.tr("service.title"), noctalia.tr("service.no_layout"))
    end
    
    lastWallpaper = currentWallpaper
    lastLayoutStr = currentLayoutStr
    return 
  end

  -- 2. Handle Widget Layout Changes
  if saveWidgets and currentLayoutStr ~= lastLayoutStr then
    noctalia.notify(noctalia.tr("service.title"), noctalia.tr("service.saved"))
    monitorWidgets[currentWallpaper] = currentLayout
    noctalia.state.set("monitorWidgets", monitorWidgets)
    
    if dataDir then
      local jsonStr = noctalia.json.encode(monitorWidgets)
      noctalia.writeFile(dataDir .. "/layouts.json", jsonStr or "{}")
    end
    
    lastLayoutStr = currentLayoutStr
  end
end