#!/bin/bash -p
# noctalia-sudo-passwordless - timed or permanent passwordless sudo grants.
#
# A port of Omarchy's omarchy-sudo-passwordless for the Noctalia
# "Passwordless Sudo" plugin (https://github.com/basecamp/omarchy,
# Copyright (c) David Heinemeier Hansson, MIT License; see LICENSE). Installed root-owned to /usr/local/bin by the
# plugin's install.sh; the root expiry timer executes this installed copy.
#
# User-facing:
#   noctalia-sudo-passwordless [MINUTES|permanent]  enable (asks sudo for a password)
#   noctalia-sudo-passwordless --disable            revoke
#   noctalia-sudo-passwordless --status             print state, exit 0 when active
#
# Internal (root only):
#   __status | __enable MINUTES|permanent | __disable | __expire UID

set -euo pipefail
umask 077
export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin
unset IFS

readonly MAX_MINUTES=1440
readonly INSTALLED_SELF=/usr/local/bin/noctalia-sudo-passwordless
readonly LOCK_FILE=/run/lock/noctalia-sudo-passwordless.lock
readonly SUDOERS_DIR=/etc/sudoers.d
readonly TMPFILES_CONF=/etc/tmpfiles.d/noctalia-nopasswd-sudo.conf
readonly PLUGIN_SERVICE=crsmthw/passwordless-sudo:service

usage() {
  echo "Usage: noctalia-sudo-passwordless [MINUTES|permanent|--disable|--status]" >&2
  echo "MINUTES must be between 1 and $MAX_MINUTES." >&2
  exit 1
}

valid_minutes() { [[ $1 =~ ^0*[1-9][0-9]{0,3}$ ]] && ((10#$1 <= MAX_MINUTES)); }
valid_duration() { [[ $1 == permanent ]] || valid_minutes "$1"; }
valid_uid() { [[ $1 =~ ^[0-9]{1,10}$ ]] && ((10#$1 >= 1 && 10#$1 <= 4294967294)); }

# Timed grants share a prefix that boot cleanup (tmpfiles r!) removes, since
# transient expiry timers do not survive a reboot. Permanent grants use a
# different prefix so the boot glob never matches them.
timed_file() { printf '%s/99-noctalia-nopasswd-%s' "$SUDOERS_DIR" "$((10#$1))"; }
permanent_file() { printf '%s/99-noctalia-permanent-nopasswd-%s' "$SUDOERS_DIR" "$((10#$1))"; }

# The caller comes from pkexec or sudo, never from argv.
caller_uid() {
  local uid=${PKEXEC_UID:-${SUDO_UID:-}}
  valid_uid "$uid" || {
    echo "Run this through pkexec or sudo as a regular user." >&2
    return 1
  }
  printf '%s' "$((10#$uid))"
}

require_root() {
  ((EUID == 0)) || { echo "This action must run as root." >&2; exit 1; }
}

# Called outside any conditional so errexit stays active in the action; the
# lock is released when the process exits.
with_lock() {
  local fd
  exec {fd}>"$LOCK_FILE"
  flock -x -w 60 "$fd"
  "$@"
}

PENDING=""
trap '[[ -z $PENDING ]] || rm -f -- "$PENDING"' EXIT

# A rule this tool wrote: "#UID ALL=(ALL) [NOTAFTER=YYYYmmddHHMMSSZ ]NOPASSWD: ALL"
read_timed_deadline() {
  local file contents
  file=$(timed_file "$1")
  [[ -f $file && ! -L $file ]] || return 1
  contents=$(<"$file")
  [[ $contents =~ ^#$((10#$1))\ ALL=\(ALL\)\ NOTAFTER=([0-9]{14})Z\ NOPASSWD:\ ALL$ ]] || return 2
  printf '%s' "${BASH_REMATCH[1]}"
}

is_permanent() {
  local file contents
  file=$(permanent_file "$1")
  [[ -f $file && ! -L $file ]] || return 1
  contents=$(<"$file")
  [[ $contents == "#$((10#$1)) ALL=(ALL) NOPASSWD: ALL" ]] || return 2
}

stamp_to_epoch() {
  local s=$1
  date -u -d "${s:0:4}-${s:4:2}-${s:6:2} ${s:8:2}:${s:10:2}:${s:12:2}" +%s
}

remove_grants() {
  rm -f -- "$(timed_file "$1")" "$(permanent_file "$1")"
}

status_locked() {
  local uid=$1 stamp deadline now
  if is_permanent "$uid"; then
    echo permanent
    return 0
  fi
  if stamp=$(read_timed_deadline "$uid"); then
    deadline=$(stamp_to_epoch "$stamp")
    now=$(date +%s)
    if ((now < deadline)); then
      echo "timed $deadline"
      return 0
    fi
    rm -f -- "$(timed_file "$uid")"
  fi
  # sudo ran us without a password, so something else grants it.
  echo external
}

sudoers_includes_dir() {
  grep -Eq '^[[:space:]]*[@#]includedir[[:space:]]+/etc/sudoers\.d/?[[:space:]]*$' /etc/sudoers
}

ensure_boot_cleanup() {
  local want='r! /etc/sudoers.d/99-noctalia-nopasswd-*'
  if [[ ! -f $TMPFILES_CONF ]] || ! grep -qxF "$want" "$TMPFILES_CONF"; then
    install -D -o root -g root -m 0644 /dev/stdin "$TMPFILES_CONF" <<EOF
# Created by noctalia-sudo-passwordless. Timed passwordless sudo grants use
# transient expiry timers that do not survive a reboot, so early boot removes
# every remaining timed grant. sudo also enforces each grant's NOTAFTER deadline.
$want
EOF
  fi
}

enable_locked() {
  local uid=$1 duration=$2 target other now expires stamp token unit
  sudoers_includes_dir || {
    echo "/etc/sudoers does not include /etc/sudoers.d, so a grant there would have no effect." >&2
    return 1
  }
  [[ -d $SUDOERS_DIR && ! -L $SUDOERS_DIR ]] || return 1

  if [[ $duration == permanent ]]; then
    target=$(permanent_file "$uid")
    other=$(timed_file "$uid")
  else
    ensure_boot_cleanup
    target=$(timed_file "$uid")
    other=$(permanent_file "$uid")
  fi

  PENDING=$(mktemp "$SUDOERS_DIR/.noctalia-nopasswd.XXXXXX")
  if [[ $duration == permanent ]]; then
    printf '#%s ALL=(ALL) NOPASSWD: ALL\n' "$uid" >"$PENDING"
  else
    now=$(date +%s)
    expires=$((now + 10#$duration * 60))
    stamp=$(date -u -d "@$expires" +%Y%m%d%H%M%S)
    printf '#%s ALL=(ALL) NOTAFTER=%sZ NOPASSWD: ALL\n' "$uid" "$stamp" >"$PENDING"
  fi
  chown root:root "$PENDING"
  chmod 0440 "$PENDING"
  visudo -cqf "$PENDING" >/dev/null

  if [[ $duration != permanent ]]; then
    token=$(tr -d '-' </proc/sys/kernel/random/uuid)
    unit="noctalia-nopasswd-expire-$uid-$token"
    systemd-run --quiet --collect --on-calendar="@$expires" \
      --timer-property=AccuracySec=1s --unit="$unit" \
      -- "$INSTALLED_SELF" __expire "$uid"
  fi

  # The temp name has a dot, which sudo ignores; the rename publishes the
  # validated rule in one step. Drop the other kind only after that.
  mv -fT -- "$PENDING" "$target"
  PENDING=""
  rm -f -- "$other"

  # Never leave sudo in a broken state.
  if ! visudo -cq >/dev/null 2>&1; then
    rm -f -- "$target"
    echo "sudoers failed validation after publishing; the grant was removed." >&2
    return 1
  fi
}

expire_locked() {
  local uid=$1 stamp deadline
  stamp=$(read_timed_deadline "$uid") || return 0
  deadline=$(stamp_to_epoch "$stamp")
  (($(date +%s) >= deadline)) && rm -f -- "$(timed_file "$uid")"
  return 0
}

notify_shell() {
  command -v noctalia >/dev/null 2>&1 &&
    noctalia msg plugin "$PLUGIN_SERVICE" all refresh >/dev/null 2>&1 || true
}

case "${1:-}" in
  __status)
    require_root
    uid=$(caller_uid)
    with_lock status_locked "$uid"
    ;;
  __enable)
    require_root
    (($# == 2)) && valid_duration "$2" || usage
    uid=$(caller_uid)
    with_lock enable_locked "$uid" "$2"
    ;;
  __disable)
    require_root
    uid=$(caller_uid)
    with_lock remove_grants "$uid"
    ;;
  __expire)
    require_root
    (($# == 2)) && valid_uid "$2" || exit 1
    with_lock expire_locked "$((10#$2))"
    ;;
  --status)
    if out=$(sudo -kn -- "$INSTALLED_SELF" __status 2>/dev/null); then
      echo "Passwordless sudo is ENABLED ($out)."
    else
      echo "Passwordless sudo is DISABLED."
      exit 3
    fi
    ;;
  --disable)
    if sudo -n -- "$INSTALLED_SELF" __disable 2>/dev/null; then
      echo "Passwordless sudo has been DISABLED."
    else
      echo "Passwordless sudo is already DISABLED."
    fi
    notify_shell
    ;;
  ""|-h|--help)
    usage
    ;;
  *)
    valid_duration "$1" || usage
    rc=0
    sudo -- "$INSTALLED_SELF" __enable "$1" || rc=$?
    notify_shell
    ((rc == 0)) || exit "$rc"
    if [[ $1 == permanent ]]; then
      echo "Passwordless sudo has been ENABLED permanently."
    else
      echo "Passwordless sudo has been ENABLED. It will automatically disable in $((10#$1)) minutes."
    fi
    ;;
esac
