--!nonstrict
-- Agent Glow companion — a pre-rendered glowing ripple orb on the wallpaper.
-- Frames are generated by frames.sh (ImageMagick) in the wallpaper-derived
-- primary color; here we just cycle them with the pulse clock. Idle shows
-- the static dim ring. No text.

local FRAMES = 20
local phase = 0 -- seconds of animation clock
local status = noctalia.state.get("status")
if type(status) ~= "table" then
  status = { active = false }
end

local function cfg(key, fallback)
  local value = noctalia.getConfig(key)
  if value == nil then
    return fallback
  end
  return value
end

local function period()
  local speed = tostring(cfg("pulse", "normal"))
  if speed == "slow" then
    return 3.0
  elseif speed == "fast" then
    return 1.0
  end
  return 2.0
end

local function framePath(index)
  local dir = noctalia.pluginDir() or ""
  return dir .. "/frames/frame-" .. string.format("%02d", index) .. ".png"
end

local function render()
  local live = status.active == true
  desktopWidget.setNeedsFrameTick(live)
  if not live then
    local dir = noctalia.pluginDir() or ""
    desktopWidget.render(ui.image({ path = dir .. "/frames/idle.png", width = 128, height = 128 }))
    return
  end
  local index = math.floor(phase / period() * FRAMES) % FRAMES
  desktopWidget.render(ui.image({ path = framePath(index), width = 128, height = 128 }))
end

noctalia.state.watch("status", function(value)
  if type(value) == "table" then
    status = value
  else
    status = { active = false }
  end
  render()
end)

function onFrameTick(deltaMs)
  if status.active ~= true then
    return
  end
  phase += (tonumber(deltaMs) or 16) / 1000
  render()
end

function update()
  desktopWidget.setWantsSecondTicks(false)
  render()
end

function onConfigChanged()
  render()
end

render()
