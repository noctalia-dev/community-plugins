--!nonstrict
-- Claude Code Usage — bar widget (thin presentation client).
--
-- The fetch logic lives in service.luau; this pill only mirrors the published
-- "usage" / "status" state. It shows the chosen rate-window utilization as
-- "NN%", colored by pacing (neutral on/under pace, warning over pace, error over
-- quota) with a "↑" cue when off-track, plus a summary tooltip.
--
-- pill_style picks the presentation: the Tabler glyph, a circular progress ring
-- (an SVG generated by ring.luau — Noctalia has no arc primitive), or the ring
-- with the percentage beside it.
--
-- Left click opens the click panel; right click forces a refresh. Both are also
-- declared as [widget.actions] defaults in plugin.toml (bindings win over these
-- callbacks; the callbacks cover a user who unbinds a gesture).

local shared = require("./shared.luau")
local ring = require("./ring.luau")
local formatTokens, formatCost = shared.formatTokens, shared.formatCost
local pace, paceColor = shared.pace, shared.paceColor
local round = shared.round

local PANEL_ID = "jrohland/claudecode:popout"

local usage = noctalia.state.get("usage")
local status = noctalia.state.get("status")

-- Settings are re-read every render so a change in the widget's settings panel
-- lands on the next tick without a reload.
local function config()
  local showGlyph = noctalia.getConfig("show_glyph")
  if showGlyph == nil then showGlyph = true end
  return {
    metric = noctalia.getConfig("pill_metric") or "five_hour",
    extras = noctalia.getConfig("pill_extras") or "none",
    style = noctalia.getConfig("pill_style") or "glyph_text",
    showGlyph = showGlyph,
    size = tonumber(noctalia.getConfig("ring_size")) or 16,
    thickness = tonumber(noctalia.getConfig("ring_thickness")) or 3,
    fillColor = noctalia.getConfig("ring_color"),
    trackColor = noctalia.getConfig("ring_track_color"),
  }
end

-- ── render ─────────────────────────────────────────────────────────────────

local function render()
  local cfg = config()

  -- Dependency / load failures: show a muted error glyph.
  if type(status) == "table" and status.available == false then
    barWidget.setGlyph("robot-off")
    barWidget.setGlyphColor("on_surface_variant")
    barWidget.setText("")
    barWidget.setTooltip(status.message ~= "" and status.message or noctalia.tr("unavailable"))
    return
  end

  if type(usage) ~= "table" then
    if cfg.showGlyph or cfg.style ~= "glyph_text" then barWidget.setGlyph("robot") end
    barWidget.setGlyphColor("on_surface_variant")
    barWidget.setText("…")
    barWidget.setColor("on_surface_variant")
    barWidget.setTooltip(noctalia.tr("loading"))
    return
  end

  local five = tonumber(usage.five_hour_util) or 0
  local seven = tonumber(usage.seven_day_util) or 0
  local pFive = pace(five, usage.five_hour_reset, shared.FIVE_HOUR_SECS)
  local pSeven = pace(seven, usage.seven_day_reset, shared.SEVEN_DAY_SECS)

  -- The ring shows one window; with metric "both" that is the 5-hour one (the
  -- one that moves minute to minute) and the text carries both numbers.
  local text, shown, arc, tracked
  if cfg.metric == "both" then
    text = `{round(five)}% · {round(seven)}%`
    shown = { pFive, pSeven }
    arc = { pct = five, p = pFive }
    tracked = { p = pFive, reset = usage.five_hour_reset }
  elseif cfg.metric == "seven_day" then
    text, shown = `{round(seven)}%`, { pSeven }
    arc = { pct = seven, p = pSeven }
    tracked = { p = pSeven, reset = usage.seven_day_reset }
  else
    text, shown = `{round(five)}%`, { pFive }
    arc = { pct = five, p = pFive }
    tracked = { p = pFive, reset = usage.five_hour_reset }
  end

  -- pill_extras rides beside the percentage, describing the window the ring
  -- tracks — the 5-hour one under "both", the same one the arc follows, so the
  -- countdown never belongs to a different window than the ring does.
  local extras = {}
  if cfg.extras == "countdown" or cfg.extras == "both" then
    local cd = shared.formatCountdownShort(tracked.reset)
    if cd then table.insert(extras, cd) end
  end
  if cfg.extras == "pace" or cfg.extras == "both" then
    -- Points ahead of (↑) or behind (↓) where the clock says the window should
    -- be. Nothing to say when the reset stamp was unusable.
    local delta = tracked.p.delta
    if delta ~= nil then
      local n = round(math.abs(delta))
      table.insert(extras, (delta >= 0) and `↑{n}` or `↓{n}`)
    end
  end
  if #extras > 0 then text = `{text} · {table.concat(extras, " ")}` end

  -- Color + caret by the worst pace status among the shown window(s).
  local worst = "unknown"
  for _, p in shown do
    if shared.SEVERITY[p.status] > shared.SEVERITY[worst] then worst = p.status end
  end
  local color = paceColor(worst, "on_surface")
  local showsPace = cfg.extras == "pace" or cfg.extras == "both"
  if not showsPace and (worst == "over" or worst == "over_quota") then
    text = `{text} ↑`
  end

  -- Ring styles. A failed write (no data dir, unwritable) falls through to the
  -- glyph pill rather than blanking the widget out.
  local ringPath = nil
  if cfg.style == "ring" or cfg.style == "ring_text" then
    ringPath = ring.path({
      frac = arc.pct / 100,
      role = paceColor(arc.p.status, "on_surface"),
    }, {
      size = cfg.size,
      thickness = cfg.thickness,
      fillColor = cfg.fillColor,
      trackColor = cfg.trackColor,
      connector = barWidget.outputName(),
    })
  end

  if ringPath then
    barWidget.setImage(ringPath, true, cfg.size, cfg.size)
    barWidget.setText(cfg.style == "ring" and "" or text)
  else
    if cfg.showGlyph then
      barWidget.setGlyph("robot")
      barWidget.setGlyphColor(color)
    end
    barWidget.setText(text)
  end
  barWidget.setColor(color)

  -- Summary tooltip. Key/value rows rather than one newline-joined string: the
  -- shell lays those out as a two-column grid, so the labels and the numbers
  -- line up instead of drifting with the width of each line.
  local rate = usage.usd_eur_rate
  local todayTokens = (type(usage.daily) == "table" and usage.daily[shared.todayIndex()]) or 0

  local rows = {}
  local function row(key, value) table.insert(rows, { key = key, value = value }) end

  -- Header: the plan on the right, so it reads as this account's identity.
  row(noctalia.tr("plan"), shared.planName(usage.subscription_type, usage.rate_limit_tier))

  -- One row per window the API enforces, including a model-scoped week when the
  -- plan has one: "16%  ·  3h 26m (19:29)" — how much is gone, how long is left,
  -- and the clock time it comes back.
  --
  -- Everything here is kept to one width on purpose. The shell right-aligns the
  -- value cell, so a row that is shorter than its neighbours pushes its
  -- percentage out of line with theirs. Two things were cut to hold that width:
  -- the pace phrase, which the column was truncating anyway and which the pill's
  -- own color and the panel both still carry, and the weekday in front of the
  -- reset time, which the countdown beside it already tells you.
  for _, w in shared.windows(usage) do
    local value = `{round(w.percent)}%`
    local countdown = shared.formatCountdownShort(w.resetIso)
    if countdown then
      local clock = shared.formatResetClock(w.resetIso)
      value = clock and `{value}  ·  {countdown} ({clock})` or `{value}  ·  {countdown}`
    end
    row(w.label, value)
  end

  row(noctalia.tr("today"), `{formatTokens(todayTokens)}  ({formatCost(usage.today_cost, rate)})`)
  row(noctalia.tr("week"), `{formatTokens(usage.week_tokens)}  ({formatCost(usage.week_cost, rate)})`)

  barWidget.setTooltip(rows)
end

-- ── wiring ─────────────────────────────────────────────────────────────────

noctalia.state.watch("usage", function(value)
  usage = value
  render()
end)

noctalia.state.watch("status", function(value)
  status = value
  render()
end)

-- A wallpaper-derived palette resolves asynchronously; redraw once it lands.
ring.setOnPaletteChanged(render)

function update()
  noctalia.setUpdateInterval(5000)
  render()
end

-- Left click: open / close the attached usage panel.
function onClick()
  noctalia.togglePanel(PANEL_ID)
end

-- Right click: force an immediate refresh (service watches refresh_nonce).
function onRightClick()
  shared.requestRefresh()
end
