--!nonstrict
-- profiles.luau — Auto-Apply Widget Profiles module for Wallpaper Deck
--
-- Manages widget layout snapshots, multi-monitor scoped patching, profiles storage,
-- and the UI for profile management, creation, and conflict resolution (quick-pick).

local M = {}

-- ── File Paths ────────────────────────────────────────────────────────────────

local function getDataDir(): string
  if type(noctalia.pluginDataDir) == "function" then
    local p = noctalia.pluginDataDir()
    if p and p ~= "" then return p end
  end
  return noctalia.expandPath("~/.local/state/noctalia/plugins/data/ishan0121/wallpaper-deck")
end

local function getLayoutsDir(): string
  return getDataDir() .. "/layouts"
end

local function getProfilesFile(): string
  return getDataDir() .. "/profiles.json"
end

local function getSettingsFile(): string
  return getDataDir() .. "/profiles_settings.json"
end

local function getPreviousLayoutFile(): string
  return getLayoutsDir() .. "/_previous.json"
end

local STATE_SETTINGS_FILE = noctalia.expandPath("~/.local/state/noctalia/settings.toml")

-- ── Module State ─────────────────────────────────────────────────────────────

M.isOpen = false
M.isAddModalOpen = false
M.isQuickPickOpen = false

M.profilesList = {} -- Array of profile objects
M.includeWidgets = true

-- O(1) in-memory lookup index by wallpaper path
local profilesByWallpaper: { [string]: boolean } = {}

local function rebuildWallpaperIndex()
  profilesByWallpaper = {}
  for _, p in ipairs(M.profilesList) do
    if p.wallpaperPath and p.wallpaperPath ~= "" then
      profilesByWallpaper[p.wallpaperPath] = true
    end
  end
end

-- Add Profile Modal form state
M.newProfileName = ""
M.newProfileTargetMonitor = "ALL"
M.newProfileBindingMode = "selected" -- "selected" or "snapshot"
M.newProfileSaveTheme = false
M.statusText = ""
M.statusIsError = false

-- Quick-Pick Popover state
M.quickPickProfiles = {}
M.quickPickFocusedIdx = 1
M.quickPickWallpaperItem = nil
M.quickPickTargetMonitor = nil

-- ── TOML Serialization Helpers ───────────────────────────────────────────────

local function tomlKey(key: string): string
  if string.match(key, "^[%a_][%w_%-]*$") then return key end
  return '"' .. string.gsub(string.gsub(key, '\\', '\\\\'), '"', '\\"') .. '"'
end

local function tomlString(v: string): string
  local s = string.gsub(v, '\\', '\\\\')
  s = string.gsub(s, '"', '\\"')
  s = string.gsub(s, '\n', '\\n')
  s = string.gsub(s, '\r', '\\r')
  s = string.gsub(s, '\t', '\\t')
  return '"' .. s .. '"'
end

local function tomlScalar(v: any): string?
  local t = type(v)
  if t == "string" then return tomlString(v) end
  if t == "boolean" then return tostring(v) end
  if t == "number" then
    if v == math.floor(v) and math.abs(v) < 2 ^ 53 then
      return string.format("%d", v)
    end
    return string.format("%.15g", v)
  end
  return nil
end

local function isScalarArray(t: any): (boolean, number)
  if type(t) ~= "table" then return false, 0 end
  local n = 0
  for k, v in pairs(t) do
    if type(k) ~= "number" or type(v) == "table" then return false, 0 end
    n = n + 1
  end
  for i = 1, n do
    if t[i] == nil then return false, 0 end
  end
  return n > 0, n
end

local function emitTable(tbl: any, path: string, out: { string })
  local scalarLines: { string } = {}
  local subTables: { string } = {}

  for k, v in pairs(tbl) do
    if type(v) == "table" then
      local isArr, n = isScalarArray(v)
      if isArr then
        local parts = {}
        for i = 1, n do
          table.insert(parts, tomlScalar(v[i]) or '""')
        end
        table.insert(scalarLines, string.format("%s = [%s]", tomlKey(k), table.concat(parts, ", ")))
      else
        table.insert(subTables, tostring(k))
      end
    else
      local s = tomlScalar(v)
      if s then
        table.insert(scalarLines, string.format("%s = %s", tomlKey(k), s))
      end
    end
  end

  table.sort(scalarLines)
  table.sort(subTables)

  if #scalarLines > 0 or #subTables == 0 then
    table.insert(out, "[" .. path .. "]")
    for _, line in ipairs(scalarLines) do
      table.insert(out, line)
    end
  end

  for _, k in ipairs(subTables) do
    table.insert(out, "")
    emitTable(tbl[k], path .. "." .. tomlKey(k), out)
  end
end

local function serializeDesktopWidgets(merged: any): string
  local out = { "# Auto-generated by Wallpaper Deck", "" }
  emitTable(merged, "desktop_widgets", out)
  return table.concat(out, "\n") .. "\n"
end

-- ── Live Config & State Persistence ──────────────────────────────────────────

local function deepCopy(orig: any): any
  if type(orig) ~= "table" then return orig end
  local copy = {}
  for k, v in pairs(orig) do
    copy[deepCopy(k)] = deepCopy(v)
  end
  return copy
end

function M.getLiveDesktopWidgets(): any
  if type(noctalia.getSetting) == "function" then
    local ok, val = pcall(noctalia.getSetting, "desktop_widgets")
    if ok and type(val) == "table" then
      return deepCopy(val)
    end
  end
  return {
    enabled = true,
    schema_version = 2,
    widget_order = {},
    widget = {},
  }
end

local function injectDesktopWidgetsIntoStateFile(tomlContent: string): (boolean, string?)
  local statePath = STATE_SETTINGS_FILE
  local existingState = ""
  local contents = noctalia.readFile(statePath)

  if contents then
    noctalia.writeFile(statePath .. ".bak", contents)
    local inDesktopWidgets = false
    for line in string.gmatch(contents, "[^\r\n]+") do
      if string.match(line, "^%s*%[%s*desktop_widgets") then
        inDesktopWidgets = true
      elseif string.match(line, "^%s*%[") then
        inDesktopWidgets = false
      end

      if not inDesktopWidgets then
        existingState = existingState .. line .. "\n"
      end
    end
  end

  local newState = existingState .. "\n" .. tomlContent
  local dir = noctalia.expandPath("~/.local/state/noctalia")
  if type(noctalia.mkdirAll) == "function" then
    noctalia.mkdirAll(dir)
  end
  local success = noctalia.writeFile(statePath, newState)
  if not success then
    return false, "Failed to write " .. statePath
  end

  -- Trigger instantaneous reload via IPC
  if type(noctalia.runAsync) == "function" then
    noctalia.runAsync({ "noctalia", "msg", "config-reload" }, function() end)
  end

  return true, nil
end

-- ── Settings (includeWidgets toggle) ──────────────────────────────────────────

function M.loadSettings()
  local path = getSettingsFile()
  if type(noctalia.readFile) == "function" and noctalia.fileExists(path) then
    local raw = noctalia.readFile(path)
    if raw and raw ~= "" then
      local ok, data = pcall(noctalia.json.decode, raw)
      if ok and type(data) == "table" and data.includeWidgets ~= nil then
        M.includeWidgets = (data.includeWidgets == true)
        return
      end
    end
  end
  M.includeWidgets = true
end

function M.saveSettings()
  local path = getSettingsFile()
  local dir = getDataDir()
  if type(noctalia.mkdirAll) == "function" then
    noctalia.mkdirAll(dir)
  end
  local raw = noctalia.json.encode({ includeWidgets = M.includeWidgets })
  if raw then
    noctalia.writeFile(path, raw)
  end
end

function M.toggleIncludeWidgets(): boolean
  M.includeWidgets = not M.includeWidgets
  M.saveSettings()
  return M.includeWidgets
end

-- ── Profiles Storage ─────────────────────────────────────────────────────────

function M.loadProfiles(): { any }
  local path = getProfilesFile()
  if type(noctalia.readFile) == "function" and noctalia.fileExists(path) then
    local raw = noctalia.readFile(path)
    if raw and raw ~= "" then
      local ok, data = pcall(noctalia.json.decode, raw)
      if ok and type(data) == "table" then
        M.profilesList = data
        rebuildWallpaperIndex()
        return M.profilesList
      end
    end
  end
  M.profilesList = {}
  rebuildWallpaperIndex()
  return M.profilesList
end

local function persistProfilesIndex(): boolean
  local path = getProfilesFile()
  local dir = getDataDir()
  if type(noctalia.mkdirAll) == "function" then
    noctalia.mkdirAll(dir)
  end
  rebuildWallpaperIndex()
  local raw = noctalia.json.encode(M.profilesList)
  if not raw then return false end
  return noctalia.writeFile(path, raw)
end

-- ── Scoped Snapshot & Restore ─────────────────────────────────────────────────

-- Snapshot current live widgets scoped to a target monitor ("all" or e.g. "HDMI-A-1")
function M.snapshotLiveLayout(monitor: string): any
  local live = M.getLiveDesktopWidgets()
  local monClean = (monitor == nil or monitor == "" or monitor == "ALL" or monitor == "all") and "all" or monitor

  if monClean == "all" then
    return live
  end

  local scopedOrder = {}
  local scopedWidgets = {}
  local liveWidgets = live.widget or {}

  for _, id in ipairs(live.widget_order or {}) do
    local w = liveWidgets[id]
    if w and w.output == monClean then
      table.insert(scopedOrder, id)
      scopedWidgets[id] = deepCopy(w)
    end
  end

  return {
    schema_version = live.schema_version or 2,
    enabled = live.enabled,
    grid = live.grid,
    widget_order = scopedOrder,
    widget = scopedWidgets,
  }
end

-- Silent safety auto-backup of live widgets right before applying any profile
function M.backupLiveLayout(): boolean
  local layoutsDir = getLayoutsDir()
  if type(noctalia.mkdirAll) == "function" then
    noctalia.mkdirAll(layoutsDir)
  end
  local live = M.snapshotLiveLayout("all")
  local raw = noctalia.json.encode(live)
  if raw then
    return noctalia.writeFile(getPreviousLayoutFile(), raw)
  end
  return false
end

function M.hasPreviousLayout(): boolean
  return noctalia.fileExists(getPreviousLayoutFile())
end

-- Revert to _previous.json
function M.revertPreviousLayout(): (boolean, string?)
  local prevFile = getPreviousLayoutFile()
  if not noctalia.fileExists(prevFile) then
    return false, "No previous layout backup found."
  end
  local raw = noctalia.readFile(prevFile)
  if not raw or raw == "" then
    return false, "Previous layout backup is empty."
  end
  local ok, layout = pcall(noctalia.json.decode, raw)
  if not ok or type(layout) ~= "table" then
    return false, "Failed to decode previous layout."
  end

  local tomlContent = serializeDesktopWidgets(layout)
  return injectDesktopWidgetsIntoStateFile(tomlContent)
end

-- Apply a saved layout with multi-monitor scoping (Patch, Don't Nuke)
function M.applyLayout(layoutData: any, targetMonitor: string): (boolean, string?)
  -- 1. Safety auto-backup live config
  M.backupLiveLayout()

  local monClean = (targetMonitor == nil or targetMonitor == "" or targetMonitor == "ALL" or targetMonitor == "all") and "all" or targetMonitor

  local merged = {}
  if monClean == "all" then
    merged = deepCopy(layoutData)
  else
    -- Scoped patch: Replace only target monitor's widgets, keep all other monitors intact
    local live = M.getLiveDesktopWidgets()
    merged = deepCopy(live)

    local targetWidgets = layoutData.widget or {}
    local targetOrder = layoutData.widget_order or {}

    local newWidgets = {}
    local newOrder = {}

    -- Keep existing widgets on other monitors
    for _, id in ipairs(merged.widget_order or {}) do
      local w = merged.widget and merged.widget[id]
      if w and w.output ~= monClean then
        table.insert(newOrder, id)
        newWidgets[id] = w
      end
    end

    -- Add target profile's widgets for this monitor
    for _, id in ipairs(targetOrder) do
      local w = targetWidgets[id]
      if w then
        local wCopy = deepCopy(w)
        wCopy.output = monClean -- ensure output matches target monitor
        table.insert(newOrder, id)
        newWidgets[id] = wCopy
      end
    end

    merged.widget = newWidgets
    merged.widget_order = newOrder
  end

  local tomlContent = serializeDesktopWidgets(merged)
  return injectDesktopWidgetsIntoStateFile(tomlContent)
end

-- ── Profile Operations ────────────────────────────────────────────────────────

function M.createProfile(name: string, wallpaperPath: string, monitor: string, theme: any?): (boolean, string?)
  if not name or string.match(name, "^%s*$") then
    return false, "Profile name cannot be empty."
  end
  if not wallpaperPath or wallpaperPath == "" then
    return false, "Wallpaper path is required."
  end

  local now = noctalia.nowMs()
  local monClean = (monitor == nil or monitor == "" or monitor == "ALL" or monitor == "all") and "all" or monitor
  local id = string.lower(string.gsub(name, "%W+", "_")) .. "_" .. tostring(now)
  local relLayoutFile = "layouts/" .. id .. ".json"
  local absLayoutFile = getLayoutsDir() .. "/" .. id .. ".json"

  -- Snapshot widgets scoped to monitor
  local layoutSnapshot = M.snapshotLiveLayout(monClean)
  local layoutsDir = getLayoutsDir()
  if type(noctalia.mkdirAll) == "function" then
    noctalia.mkdirAll(layoutsDir)
  end

  local raw = noctalia.json.encode(layoutSnapshot)
  if not raw or not noctalia.writeFile(absLayoutFile, raw) then
    return false, "Failed to write layout file: " .. absLayoutFile
  end

  local profileEntry = {
    id = id,
    name = name,
    wallpaperPath = wallpaperPath,
    monitor = monClean,
    layoutFile = relLayoutFile,
    createdAt = now,
    lastUsedAt = now,
  }
  if theme and theme.source and theme.name then
    profileEntry.theme = {
      source = theme.source,
      name = theme.name,
    }
  end

  table.insert(M.profilesList, profileEntry)
  persistProfilesIndex()
  return true, nil
end

function M.updateProfileLayout(profileId: string): (boolean, string?)
  for _, p in ipairs(M.profilesList) do
    if p.id == profileId then
      local absFile = getDataDir() .. "/" .. (p.layoutFile or ("layouts/" .. p.id .. ".json"))
      local snapshot = M.snapshotLiveLayout(p.monitor)
      local raw = noctalia.json.encode(snapshot)
      if not raw or not noctalia.writeFile(absFile, raw) then
        return false, "Failed to update layout file."
      end
      p.lastUsedAt = noctalia.nowMs()
      persistProfilesIndex()
      return true, nil
    end
  end
  return false, "Profile not found."
end

function M.getProfileById(profileId: string): any?
  for _, p in ipairs(M.profilesList) do
    if p.id == profileId then
      return p
    end
  end
  return nil
end

function M.deleteProfile(profileId: string): (boolean, string?)
  local targetIdx = nil
  local layoutRel = nil
  for idx, p in ipairs(M.profilesList) do
    if p.id == profileId then
      targetIdx = idx
      layoutRel = p.layoutFile
      break
    end
  end

  if not targetIdx then
    return false, "Profile not found."
  end

  table.remove(M.profilesList, targetIdx)
  persistProfilesIndex()

  if layoutRel then
    local absFile = getDataDir() .. "/" .. layoutRel
    if noctalia.fileExists(absFile) and type(noctalia.removeFile) == "function" then
      pcall(noctalia.removeFile, absFile)
    end
  end

  return true, nil
end

function M.applyProfile(profile: any, onWallpaperApply: ((path: string, monitor: string?) -> ()))
  if not profile then return false, "No profile provided" end

  -- 1. Apply Widget Layout
  local layoutAbs = getDataDir() .. "/" .. (profile.layoutFile or ("layouts/" .. profile.id .. ".json"))
  if noctalia.fileExists(layoutAbs) then
    local raw = noctalia.readFile(layoutAbs)
    if raw and raw ~= "" then
      local ok, layout = pcall(noctalia.json.decode, raw)
      if ok and type(layout) == "table" then
        M.applyLayout(layout, profile.monitor)
      end
    end
  end

  -- 2. Apply Theme if linked
  if profile.theme and profile.theme.source and profile.theme.name then
    if type(noctalia.runAsync) == "function" then
      noctalia.runAsync({ "noctalia", "msg", "color-scheme-set", profile.theme.source, profile.theme.name }, function() end)
    end
  end

  -- 3. Apply Wallpaper
  if profile.wallpaperPath and profile.wallpaperPath ~= "" and onWallpaperApply then
    local out = (profile.monitor == "all" or profile.monitor == "ALL") and nil or profile.monitor
    onWallpaperApply(profile.wallpaperPath, out)
  end

  -- 4. Update lastUsedAt
  profile.lastUsedAt = noctalia.nowMs()
  persistProfilesIndex()

  return true, nil
end

-- ── Card Badge & Conflict Matching ──────────────────────────────────────────

function M.hasProfileForWallpaper(wallpaperPath: string?): boolean
  if not wallpaperPath or wallpaperPath == "" then return false end
  return profilesByWallpaper[wallpaperPath] == true
end

function M.getProfilesForWallpaper(wallpaperPath: string?, targetMonitor: string?): { any }
  if not wallpaperPath or wallpaperPath == "" then return {} end
  local monClean = (targetMonitor == nil or targetMonitor == "" or targetMonitor == "ALL" or targetMonitor == "all") and "all" or targetMonitor

  local exactMatches = {}
  local allMonMatches = {}
  local anyMatches = {}

  for _, p in ipairs(M.profilesList) do
    if p.wallpaperPath == wallpaperPath then
      table.insert(anyMatches, p)
      if p.monitor == monClean then
        table.insert(exactMatches, p)
      elseif p.monitor == "all" then
        table.insert(allMonMatches, p)
      end
    end
  end

  local results = {}
  if #exactMatches > 0 then
    results = exactMatches
    if monClean ~= "all" and #allMonMatches > 0 then
      for _, p in ipairs(allMonMatches) do
        table.insert(results, p)
      end
    end
  elseif monClean ~= "all" and #allMonMatches > 0 then
    results = allMonMatches
  else
    results = anyMatches
  end

  -- Sort descending by lastUsedAt
  table.sort(results, function(a, b)
    return (a.lastUsedAt or 0) > (b.lastUsedAt or 0)
  end)

  return results
end

-- ── UI Rendering: Profiles Modal ──────────────────────────────────────────────

function M.renderProfilesModal(
  U: any,
  panelW: number,
  panelH: number,
  R: (number) -> number,
  renderFn: () -> (),
  onWallpaperApply: (path: string, monitor: string?) -> (),
  currentActiveWallpaper: string,
  centerCardWallpaper: string,
  connectedMonitors: { string },
  selectedOutput: string
): any
  local cardW = math.min(panelW - 48, 760)
  local cardH = math.min(panelH - 60, 600)
  local scrollH = cardH - 140

  -- If the Add Profile sub-modal is open, render it instead
  if M.isAddModalOpen then
    return M.renderAddProfileModal(
      U, panelW, panelH, R, renderFn,
      currentActiveWallpaper, centerCardWallpaper, connectedMonitors, selectedOutput
    )
  end

  -- Build list rows of saved profiles
  local profileRows = {}
  if #M.profilesList == 0 then
    table.insert(profileRows, U.column({
      align = "center",
      justify = "center",
      gap = 10,
      height = 200,
      flexGrow = 1,
    }, {
      U.glyph({ name = "layout-grid", size = 32, color = "on_surface_variant/0.5" }),
      U.label({ text = "No widget profiles saved yet.", color = "on_surface_variant", fontSize = 13 }),
      U.label({
        text = "Click 'Add Profile' to snapshot your live widgets and bind them to a wallpaper.",
        color = "on_surface_variant/0.7",
        fontSize = 11,
      }),
    }))
  else
    -- Sort profiles by lastUsedAt descending
    local sorted = {}
    for _, p in ipairs(M.profilesList) do table.insert(sorted, p) end
    table.sort(sorted, function(a, b) return (a.lastUsedAt or 0) > (b.lastUsedAt or 0) end)

    for idx, p in ipairs(sorted) do
      local wpName = string.match(p.wallpaperPath or "", "([^/]+)$") or p.wallpaperPath or "None"
      local monText = (p.monitor == "all" or p.monitor == "ALL") and "All Monitors" or p.monitor
      local hasTheme = (p.theme ~= nil and p.theme.name ~= nil)

      local infoRows = {
        U.row({ align = "center", gap = 8 }, {
          U.label({ text = p.name, color = "on_surface", fontSize = 13, fontWeight = "bold" }),
          U.row({
            fill = "primary/0.15",
            radius = R(4),
            paddingH = 6,
            paddingV = 2,
          }, {
            U.label({ text = monText, color = "primary", fontSize = 10, fontWeight = "bold" }),
          }),
        }),
        U.row({ align = "center", gap = 6 }, {
          U.glyph({ name = "photo", size = 11, color = "on_surface_variant/0.7" }),
          U.label({ text = wpName, color = "on_surface_variant", fontSize = 11, maxWidth = 340, maxLines = 1 }),
        }),
      }

      if hasTheme then
        table.insert(infoRows[1], U.row({
          fill = "secondary/0.15",
          radius = R(4),
          paddingH = 6,
          paddingV = 2,
        }, {
          U.label({ text = "Theme: " .. p.theme.name, color = "secondary", fontSize = 10 }),
        }))
      end

      table.insert(profileRows, U.row({
        key = "profile_item_" .. p.id,
        align = "center",
        justify = "space_between",
        fill = "surface_container/0.6",
        border = "outline_variant/0.25",
        borderWidth = 1,
        radius = R(10),
        padding = 10,
        gap = 8,
      }, {
        -- Left side: Wallpaper thumbnail if available + metadata
        U.row({ align = "center", gap = 12, flexGrow = 1 }, {
          (p.wallpaperPath and noctalia.fileExists(p.wallpaperPath)) and U.image({
            path = p.wallpaperPath,
            width = 64,
            height = 42,
            radius = R(6),
            fit = "cover",
            border = "outline_variant/0.2",
            borderWidth = 1,
          }) or U.box({
            width = 64,
            height = 42,
            radius = R(6),
            fill = "surface_container_highest",
          }),
          U.column({ gap = 4, flexGrow = 1 }, infoRows),
        }),

        -- Right side actions: Apply, Update, Delete
        U.row({ align = "center", gap = 6 }, {
          U.button({
            text = "Apply",
            glyph = "check",
            variant = "primary",
            controlSize = "sm",
            tooltip = "Apply wallpaper and widget layout",
            onClick = function()
              M.applyProfile(p, onWallpaperApply)
              M.isOpen = false
              renderFn()
            end,
          }),
          U.button({
            glyph = "refresh",
            variant = "secondary",
            controlSize = "sm",
            tooltip = "Update profile layout with current live desktop widgets",
            onClick = function()
              local ok, err = M.updateProfileLayout(p.id)
              if ok then
                M.statusText = "Updated layout for '" .. p.name .. "'."
                M.statusIsError = false
              else
                M.statusText = err or "Update failed."
                M.statusIsError = true
              end
              renderFn()
            end,
          }),
          U.button({
            glyph = "trash",
            variant = "ghost",
            controlSize = "sm",
            tooltip = "Delete profile",
            onClick = function()
              M.deleteProfile(p.id)
              renderFn()
            end,
          }),
        }),
      }))
    end
  end

  local canRevert = M.hasPreviousLayout()

  local modalCard = U.column({
    key = "profiles_manager_card",
    fill = "surface",
    border = "outline_variant/0.4",
    borderWidth = 1,
    radius = R(16),
    padding = 16,
    gap = 12,
    width = cardW,
  }, {
    -- Header
    U.row({ align = "center", justify = "space_between" }, {
      U.row({ align = "center", gap = 8 }, {
        U.glyph({ name = "layout-grid", size = 18, color = "primary" }),
        U.label({ text = "Desktop Widget Profiles", color = "on_surface", fontSize = 15, fontWeight = "bold" }),
      }),
      U.button({
        glyph = "x",
        variant = "ghost",
        controlSize = "sm",
        onClick = function()
          M.isOpen = false
          M.statusText = ""
          M.statusIsError = false
          renderFn()
        end,
      }),
    }),

    -- Status row if set
    (M.statusText ~= "") and U.row({
      fill = M.statusIsError and "error/0.15" or "primary/0.15",
      radius = R(6),
      paddingH = 10,
      paddingV = 4,
    }, {
      U.label({
        text = M.statusText,
        color = M.statusIsError and "error" or "primary",
        fontSize = 11,
      }),
    }) or U.spacer({ height = 1 }),

    -- Scrollable Profiles List
    U.scroll({
      key = "profiles_scroll_list",
      height = scrollH,
      gap = 8,
      align = "stretch",
    }, profileRows),

    -- Footer Actions
    U.row({ align = "center", justify = "space_between", paddingV = 4 }, {
      U.button({
        text = "Revert Previous Layout",
        glyph = "restore",
        variant = "ghost",
        controlSize = "sm",
        tooltip = canRevert and "Restore live widgets snapshot taken before the last profile was applied" or "No previous safety backup found",
        onClick = function()
          local ok, err = M.revertPreviousLayout()
          if ok then
            M.statusText = "Restored previous widget layout."
            M.statusIsError = false
          else
            M.statusText = err or "Revert failed."
            M.statusIsError = true
          end
          renderFn()
        end,
      }),

      U.row({ align = "center", gap = 8 }, {
        U.button({
          text = "Add Profile",
          glyph = "plus",
          variant = "primary",
          controlSize = "sm",
          onClick = function()
            M.isAddModalOpen = true
            M.newProfileName = ""
            M.newProfileTargetMonitor = (selectedOutput and selectedOutput ~= "") and selectedOutput or "ALL"
            M.newProfileBindingMode = "selected"
            M.newProfileSaveTheme = false
            M.statusText = ""
            M.statusIsError = false
            renderFn()
          end,
        }),
      }),
    }),
  })

  return U.column({
    key = "profiles_modal_overlay",
    width = panelW,
    height = panelH,
    align = "center",
    justify = "center",
    fill = "shadow/0.75",
  }, { modalCard })
end

-- ── UI Rendering: Add Profile Modal ──────────────────────────────────────────

function M.renderAddProfileModal(
  U: any,
  panelW: number,
  panelH: number,
  R: (number) -> number,
  renderFn: () -> (),
  currentActiveWallpaper: string,
  centerCardWallpaper: string,
  connectedMonitors: { string },
  selectedOutput: string
): any
  local cardW = math.min(panelW - 64, 540)

  local resolvedWallpaper = (M.newProfileBindingMode == "snapshot") and currentActiveWallpaper or centerCardWallpaper
  if not resolvedWallpaper or resolvedWallpaper == "" then
    resolvedWallpaper = centerCardWallpaper or currentActiveWallpaper or ""
  end

  local monitorOptions = {}
  for _, m in ipairs(connectedMonitors or { "ALL" }) do
    table.insert(monitorOptions, m)
  end

  local currentMonIdx = 1
  for idx, m in ipairs(monitorOptions) do
    if m == M.newProfileTargetMonitor then
      currentMonIdx = idx
      break
    end
  end

  local modalCard = U.column({
    key = "add_profile_card",
    fill = "surface",
    border = "outline_variant/0.4",
    borderWidth = 1,
    radius = R(16),
    padding = 20,
    gap = 14,
    width = cardW,
  }, {
    -- Header
    U.row({ align = "center", justify = "space_between" }, {
      U.row({ align = "center", gap = 8 }, {
        U.glyph({ name = "plus", size = 16, color = "primary" }),
        U.label({ text = "Add Widget Profile", color = "on_surface", fontSize = 15, fontWeight = "bold" }),
      }),
      U.button({
        glyph = "x",
        variant = "ghost",
        controlSize = "sm",
        onClick = function()
          M.isAddModalOpen = false
          renderFn()
        end,
      }),
    }),

    -- Binding Mode Segmented Control
    U.column({ gap = 6 }, {
      U.label({ text = "Wallpaper Source", color = "on_surface_variant", fontSize = 12 }),
      U.row({ gap = 8 }, {
        U.button({
          text = "Selected Card",
          glyph = "cards",
          variant = (M.newProfileBindingMode == "selected") and "primary" or "secondary",
          controlSize = "sm",
          tooltip = "Bind to the wallpaper currently centered in Wallpaper Deck",
          onClick = function()
            M.newProfileBindingMode = "selected"
            renderFn()
          end,
        }),
        U.button({
          text = "Current Desktop",
          glyph = "device-desktop",
          variant = (M.newProfileBindingMode == "snapshot") and "primary" or "secondary",
          controlSize = "sm",
          tooltip = "Bind to the currently active desktop wallpaper",
          onClick = function()
            M.newProfileBindingMode = "snapshot"
            renderFn()
          end,
        }),
      }),
      U.label({
        text = (resolvedWallpaper ~= "") and ("Target: " .. (string.match(resolvedWallpaper, "([^/]+)$") or resolvedWallpaper)) or "Warning: No wallpaper selected",
        color = (resolvedWallpaper ~= "") and "on_surface_variant/0.8" or "error",
        fontSize = 11,
      }),
    }),

    -- Profile Name input
    U.column({ gap = 6 }, {
      U.label({ text = "Profile Name", color = "on_surface_variant", fontSize = 12 }),
      U.input({
        key = "new_profile_name_input",
        value = M.newProfileName,
        placeholder = "e.g. Minimal Coding, Focus Setup",
        controlSize = "sm",
        frameVisible = true,
        width = cardW - 40,
        onChange = function(val)
          M.newProfileName = val or ""
        end,
      }),
    }),

    -- Target Monitor selector
    U.column({ gap = 6 }, {
      U.label({ text = "Target Monitor", color = "on_surface_variant", fontSize = 12 }),
      U.row({ gap = 6 }, (function()
        local buttons = {}
        for idx, m in ipairs(monitorOptions) do
          local isSel = (m == M.newProfileTargetMonitor)
          table.insert(buttons, U.button({
            text = (m == "ALL") and "All Monitors" or m,
            glyph = (m == "ALL") and "devices" or "screen-share",
            variant = isSel and "primary" or "ghost",
            controlSize = "sm",
            onClick = function()
              M.newProfileTargetMonitor = m
              renderFn()
            end,
          }))
        end
        return buttons
      end)()),
    }),

    -- Checkbox: Save current color scheme
    U.row({ align = "center", gap = 8 }, {
      U.button({
        glyph = M.newProfileSaveTheme and "checkbox" or "square",
        variant = "ghost",
        controlSize = "sm",
        onClick = function()
          M.newProfileSaveTheme = not M.newProfileSaveTheme
          renderFn()
        end,
      }),
      U.label({ text = "Also save and apply active color scheme", color = "on_surface", fontSize = 12 }),
    }),

    -- Status message if any
    (M.statusText ~= "") and U.row({
      fill = M.statusIsError and "error/0.15" or "primary/0.15",
      radius = R(6),
      paddingH = 10,
      paddingV = 4,
    }, {
      U.label({
        text = M.statusText,
        color = M.statusIsError and "error" or "primary",
        fontSize = 11,
      }),
    }) or U.spacer({ height = 1 }),

    -- Actions: Cancel / Save
    U.row({ align = "center", justify = "end", gap = 8, paddingV = 8 }, {
      U.button({
        text = "Cancel",
        variant = "ghost",
        controlSize = "sm",
        onClick = function()
          M.isAddModalOpen = false
          M.statusText = ""
          M.statusIsError = false
          renderFn()
        end,
      }),
      U.button({
        text = "Save Profile",
        glyph = "check",
        variant = "primary",
        controlSize = "sm",
        onClick = function()
          if not M.newProfileName or string.match(M.newProfileName, "^%s*$") then
            M.statusText = "Please enter a profile name."
            M.statusIsError = true
            renderFn()
            return
          end

          if not resolvedWallpaper or resolvedWallpaper == "" then
            M.statusText = "No wallpaper found to bind."
            M.statusIsError = true
            renderFn()
            return
          end

          local themeInfo = nil
          if M.newProfileSaveTheme and type(noctalia.getSetting) == "function" then
            local src = noctalia.getSetting("theme.source") or "custom"
            local name = noctalia.getSetting("theme.name") or noctalia.getSetting("theme.wallpaper_scheme") or "default"
            themeInfo = { source = src, name = name }
          end

          local ok, err = M.createProfile(
            M.newProfileName,
            resolvedWallpaper,
            M.newProfileTargetMonitor,
            themeInfo
          )

          if ok then
            M.isAddModalOpen = false
            M.statusText = "Profile created successfully."
            M.statusIsError = false
          else
            M.statusText = err or "Failed to create profile."
            M.statusIsError = true
          end
          renderFn()
        end,
      }),
    }),
  })

  return U.column({
    key = "add_profile_overlay",
    width = panelW,
    height = panelH,
    align = "center",
    justify = "center",
    fill = "shadow/0.75",
  }, { modalCard })
end

-- ── UI Rendering: Quick-Pick Popover (Conflict Resolution) ────────────────────

function M.openQuickPick(
  profiles: { any },
  wallpaperItem: any,
  targetMonitor: string?
)
  M.quickPickProfiles = profiles
  M.quickPickFocusedIdx = 1
  M.quickPickWallpaperItem = wallpaperItem
  M.quickPickTargetMonitor = targetMonitor
  M.isQuickPickOpen = true
end

function M.closeQuickPick()
  M.isQuickPickOpen = false
  M.quickPickProfiles = {}
  M.quickPickWallpaperItem = nil
  M.quickPickTargetMonitor = nil
end

function M.renderQuickPickPopover(
  U: any,
  panelW: number,
  panelH: number,
  R: (number) -> number,
  renderFn: () -> (),
  onApplyProfile: (profile: any) -> (),
  onApplyWallpaperOnly: (wallpaperItem: any, targetMonitor: string?) -> ()
): any
  local popoverW = math.min(panelW - 64, 460)

  local profileButtons = {}
  for idx, p in ipairs(M.quickPickProfiles) do
    local isFocused = (idx == M.quickPickFocusedIdx)
    local monText = (p.monitor == "all" or p.monitor == "ALL") and "All Monitors" or p.monitor

    table.insert(profileButtons, U.button({
      key = "qp_btn_" .. p.id,
      text = p.name .. " (" .. monText .. ")",
      glyph = isFocused and "check" or "layout-grid",
      variant = isFocused and "primary" or "secondary",
      controlSize = "sm",
      tooltip = "Apply profile: " .. p.name,
      onClick = function()
        M.closeQuickPick()
        onApplyProfile(p)
      end,
    }))
  end

  -- Wallpaper Only option
  local isWpOnlyFocused = (M.quickPickFocusedIdx > #M.quickPickProfiles)
  table.insert(profileButtons, U.button({
    key = "qp_btn_wp_only",
    text = "Wallpaper Only (Skip Widgets)",
    glyph = "photo",
    variant = isWpOnlyFocused and "primary" or "ghost",
    controlSize = "sm",
    tooltip = "Apply wallpaper without altering desktop widgets",
    onClick = function()
      local item = M.quickPickWallpaperItem
      local mon = M.quickPickTargetMonitor
      M.closeQuickPick()
      onApplyWallpaperOnly(item, mon)
    end,
  }))

  local popoverCard = U.column({
    key = "quick_pick_card",
    fill = "surface",
    border = "primary/0.5",
    borderWidth = 1.5,
    radius = R(14),
    padding = 16,
    gap = 10,
    width = popoverW,
  }, {
    U.row({ align = "center", justify = "space_between" }, {
      U.row({ align = "center", gap = 8 }, {
        U.glyph({ name = "layout-grid", size = 16, color = "primary" }),
        U.label({ text = "Select Widget Profile", color = "on_surface", fontSize = 14, fontWeight = "bold" }),
      }),
      U.button({
        glyph = "x",
        variant = "ghost",
        controlSize = "sm",
        onClick = function()
          M.closeQuickPick()
          renderFn()
        end,
      }),
    }),
    U.label({
      text = "Multiple profiles are linked to this wallpaper. Pick which one to apply:",
      color = "on_surface_variant",
      fontSize = 11,
    }),
    U.column({ gap = 6 }, profileButtons),
  })

  return U.column({
    key = "quick_pick_overlay",
    width = panelW,
    height = panelH,
    align = "center",
    justify = "center",
    fill = "shadow/0.60",
  }, { popoverCard })
end

-- ── Keyboard Handler ──────────────────────────────────────────────────────────

function M.onKey(
  chord: string,
  pressed: boolean,
  renderFn: () -> (),
  onApplyProfile: (profile: any) -> (),
  onApplyWallpaperOnly: (wallpaperItem: any, targetMonitor: string?) -> ()
): boolean
  if not pressed then return false end
  local chordLower = string.lower(chord)

  -- Quick-Pick Popover keyboard handling
  if M.isQuickPickOpen then
    if chordLower == "escape" then
      M.closeQuickPick()
      renderFn()
      return true
    end

    local totalOptions = #M.quickPickProfiles + 1 -- plus 1 for "Wallpaper Only"
    if chordLower == "up" or chordLower == "k" then
      M.quickPickFocusedIdx = ((M.quickPickFocusedIdx - 2 + totalOptions) % totalOptions) + 1
      renderFn()
      return true
    elseif chordLower == "down" or chordLower == "j" then
      M.quickPickFocusedIdx = (M.quickPickFocusedIdx % totalOptions) + 1
      renderFn()
      return true
    elseif chordLower == "return" or chordLower == "enter" or chordLower == "kp_enter" then
      if M.quickPickFocusedIdx <= #M.quickPickProfiles then
        local p = M.quickPickProfiles[M.quickPickFocusedIdx]
        M.closeQuickPick()
        onApplyProfile(p)
      else
        local item = M.quickPickWallpaperItem
        local mon = M.quickPickTargetMonitor
        M.closeQuickPick()
        onApplyWallpaperOnly(item, mon)
      end
      return true
    end
    return true
  end

  -- Add Profile modal keyboard handling
  if M.isAddModalOpen then
    if chordLower == "escape" then
      M.isAddModalOpen = false
      M.statusText = ""
      M.statusIsError = false
      renderFn()
      return true
    end
    return true -- suppress deck navigation while modal open
  end

  -- Profiles Management modal keyboard handling
  if M.isOpen then
    if chordLower == "escape" then
      M.isOpen = false
      M.statusText = ""
      M.statusIsError = false
      renderFn()
      return true
    end
    return true -- suppress deck navigation while modal open
  end

  return false
end

-- Initialize settings on module require
M.loadSettings()
M.loadProfiles()

return M
