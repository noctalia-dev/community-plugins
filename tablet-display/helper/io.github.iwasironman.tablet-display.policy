<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Noctalia Tablet Display plugin</vendor>
  <vendor_url>https://github.com/iwasironman/noctalia-tablet-display</vendor_url>

  <action id="io.github.iwasironman.tablet-display.port">
    <description>Use an unused display port as a tablet display</description>
    <message>Authentication is required to turn a display port on or off</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/noctalia-tablet-display/port-helper</annotate>
  </action>
</policyconfig>
