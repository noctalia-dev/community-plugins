--!nonstrict

local REQUEST_KEY = "hypr-display-config.apply_request"
local RESULT_KEY = "hypr-display-config.apply_result"

function computePositions(orderList, monitorsByName)
  local positions = {}
  local cursorX = 0
  for _, name in ipairs(orderList) do
    local monitor = monitorsByName[name]
    if monitor ~= nil then
      positions[name] = { x = cursorX, y = 0 }
      local scale = monitor.scale
      if scale == nil or scale <= 0 then scale = 1 end
      cursorX = cursorX + math.floor(monitor.width / scale)
    end
  end
  return positions
end

local function formatScale(value)
  if value == math.floor(value) then
    return string.format("%d", value)
  end
  return tostring(value)
end

function renderManagedFile(monitors)
  local lines = {
    "-- Generated by maddingo/hypr-display-config. Do not edit by hand;",
    "-- changes made here are overwritten the next time the plugin applies.",
    "",
  }
  for _, monitor in ipairs(monitors) do
    local position = string.format("%dx%d", monitor.x, monitor.y)
    lines[#lines + 1] = string.format(
      'hl.monitor({ output = %q, mode = %q, position = %q, scale = %s, transform = %d, disabled = %s })',
      monitor.name, monitor.mode, position, formatScale(monitor.scale),
      monitor.transform, tostring(monitor.disabled)
    )
  end
  lines[#lines + 1] = ""
  for _, monitor in ipairs(monitors) do
    for _, workspaceId in ipairs(monitor.workspaces) do
      lines[#lines + 1] = string.format(
        'hl.workspace_rule({ workspace = "%d", monitor = %q })',
        workspaceId, monitor.name
      )
    end
  end
  lines[#lines + 1] = ""
  return table.concat(lines, "\n")
end

function ensureRequireLine(text, requireLine)
  for line in (text .. "\n"):gmatch("([^\n]*)\n") do
    if line == requireLine then
      return text
    end
  end
  if text:sub(-1) ~= "\n" then
    text = text .. "\n"
  end
  return text .. requireLine .. "\n"
end

local function shellQuote(value)
  return "'" .. value:gsub("'", "'\\''") .. "'"
end

local function managedFilePath(hyprlandConfigPath)
  local directory = hyprlandConfigPath:match("^(.*)/[^/]*$") or "."
  return directory .. "/hypr-display-config.lua"
end

-- Hyprland 0.56.2 selects its config parser purely by file extension: a path
-- ending in `.lua` gets the native Lua config parser, anything else
-- (including a naively-appended `.tmp`) falls back to the legacy conf-file
-- parser, which cannot parse Lua syntax at all and both rejects valid Lua and
-- (worse) can silently accept malformed Lua that happens to look like
-- `key = value` conf syntax. Every temp path we hand to
-- `Hyprland --verify-config` MUST still end in `.lua`.
local function tempLuaPath(path)
  local base = path:match("^(.*)%.lua$") or path
  return base .. ".tmp.lua"
end

local function liveApply(monitors, onComplete)
  -- `dispatching` stays true while we're still issuing hyprctl eval calls below.
  -- Guarding on it (in addition to `pending == 0`) keeps this correct whether
  -- noctalia.runAsync's callback fires synchronously (as our test doubles do)
  -- or truly asynchronously (as the real API does): without it, a synchronous
  -- callback would drive `pending` back to 0 after the very first call and
  -- fire onComplete before the remaining calls were even issued.
  local pending = 0
  local failures = {}
  local dispatching = true
  local function maybeFinish()
    if not dispatching and pending == 0 then
      onComplete(failures)
    end
  end
  local function trackedRun(script)
    pending = pending + 1
    noctalia.runAsync("hyprctl eval " .. shellQuote(script), function(result)
      if result.exitCode ~= 0 then
        failures[#failures + 1] = script
      end
      pending = pending - 1
      maybeFinish()
    end)
  end
  for _, monitor in ipairs(monitors) do
    local position = "auto"
    if monitor.x ~= nil and monitor.y ~= nil then
      position = string.format("%dx%d", monitor.x, monitor.y)
    end
    trackedRun(string.format(
      'hl.monitor({ output = %q, mode = %q, position = %q, scale = %s, transform = %d, disabled = %s })',
      monitor.name, monitor.mode, position, formatScale(monitor.scale),
      monitor.transform, tostring(monitor.disabled)
    ))
  end
  for _, monitor in ipairs(monitors) do
    for _, workspaceId in ipairs(monitor.workspaces) do
      trackedRun(string.format(
        'hl.workspace_rule({ workspace = "%d", monitor = %q })',
        workspaceId, monitor.name
      ))
      trackedRun(string.format(
        'hl.dispatch(hl.dsp.workspace.move({ workspace = "%d", monitor = %q }))',
        workspaceId, monitor.name
      ))
    end
  end
  dispatching = false
  maybeFinish()
end

local function publishResult(requestId, status, message)
  noctalia.state.set(RESULT_KEY, {
    request_id = requestId,
    status = status,
    message = message,
  })
end

local function liveApplyWarningMessage(failures)
  if #failures == 0 then return nil end
  return "applied with " .. tostring(#failures)
    .. " live-update warning(s), see hyprctl reload"
end

local function commitManagedFile(hyprlandConfigPath, content, requestId, liveApplyFailures)
  local targetPath = managedFilePath(hyprlandConfigPath)
  local tempPath = tempLuaPath(targetPath)
  if not noctalia.writeFile(tempPath, content) then
    publishResult(requestId, "error", "failed to write temp file " .. tempPath)
    return
  end
  if not noctalia.commandExists("Hyprland") then
    publishResult(requestId, "error", "Hyprland binary not found on PATH, cannot validate")
    return
  end
  noctalia.runAsync("Hyprland --verify-config -c " .. shellQuote(tempPath), function(result)
    if result.exitCode ~= 0 then
      publishResult(requestId, "error", "config validation failed: " .. tostring(result.stderr or result.stdout or ""))
      return
    end
    if not noctalia.writeFile(targetPath, content) then
      publishResult(requestId, "error", "failed to write " .. targetPath)
      return
    end

    local function reloadAndPublishOk()
      noctalia.runAsync("hyprctl reload", function(reloadResult)
        if reloadResult.exitCode ~= 0 then
          publishResult(requestId, "error", "hyprctl reload failed")
          return
        end
        publishResult(requestId, "ok", liveApplyWarningMessage(liveApplyFailures or {}))
      end)
    end

    local requireLine = 'require("hypr-display-config")'
    local existing = noctalia.readFile(hyprlandConfigPath) or ""
    local updated = ensureRequireLine(existing, requireLine)
    if updated == existing then
      -- require() line already present; nothing to validate or rewrite.
      reloadAndPublishOk()
      return
    end

    -- The managed file's own content was already independently validated
    -- above, but appending a require() line to the user's hyprland.lua can
    -- itself produce invalid Lua (e.g. if the file ends in a top-level
    -- `return`). Validate the rewritten hyprland.lua the same way before
    -- committing it, and leave the real file untouched if it fails.
    local hyprlandTempPath = tempLuaPath(hyprlandConfigPath)
    if not noctalia.writeFile(hyprlandTempPath, updated) then
      publishResult(requestId, "error", "failed to write temp file " .. hyprlandTempPath)
      return
    end
    noctalia.runAsync("Hyprland --verify-config -c " .. shellQuote(hyprlandTempPath), function(verifyResult)
      if verifyResult.exitCode ~= 0 then
        publishResult(requestId, "error",
          "hyprland.lua would become invalid after inserting the require line: "
            .. tostring(verifyResult.stderr or verifyResult.stdout or ""))
        return
      end
      if not noctalia.writeFile(hyprlandConfigPath, updated) then
        publishResult(requestId, "error", "failed to update " .. hyprlandConfigPath)
        return
      end
      reloadAndPublishOk()
    end)
  end)
end

local function handleApplyRequest(request)
  if type(request) ~= "table" or type(request.monitors) ~= "table" then
    local requestId = ""
    if type(request) == "table" then
      requestId = tostring(request.request_id or "")
    end
    publishResult(requestId, "error", "malformed apply request")
    return
  end
  local requestId = tostring(request.request_id or "")

  local orderList = {}
  local monitorsByName = {}
  for _, monitor in ipairs(request.monitors) do
    orderList[#orderList + 1] = monitor.name
    monitorsByName[monitor.name] = monitor
  end
  local positions = computePositions(orderList, monitorsByName)

  local monitorsWithPositions = {}
  for _, monitor in ipairs(request.monitors) do
    local position = positions[monitor.name] or { x = 0, y = 0 }
    monitorsWithPositions[#monitorsWithPositions + 1] = {
      name = monitor.name,
      mode = monitor.mode,
      scale = monitor.scale,
      transform = monitor.transform,
      disabled = monitor.disabled,
      workspaces = monitor.workspaces,
      x = position.x,
      y = position.y,
    }
  end

  liveApply(monitorsWithPositions, function(failures)
    local hyprlandConfigPath = noctalia.expandPath(noctalia.getConfig("hyprland_config"))
    local content = renderManagedFile(monitorsWithPositions)
    commitManagedFile(hyprlandConfigPath, content, requestId, failures)
  end)
end

noctalia.state.watch(REQUEST_KEY, handleApplyRequest)
