local util = require("./lib/util.luau")
local hypr = require("./lib/hypr.luau")
local schema = require("./lib/schema.luau")

local DEBOUNCE_MS = 750

local dirty = false
local deadline = 0
local pendingForce = false
local lastWritten = nil

hypr.transport = noctalia.state.get("hm.transport") or hypr.TRANSPORT.UNKNOWN
hypr.configType = noctalia.state.get("hm.config_type") or "unknown"
noctalia.state.watch("hm.transport", function(value)
  if type(value) == "string" then hypr.transport = value end
end)
noctalia.state.watch("hm.config_type", function(value)
  if type(value) == "string" then hypr.configType = value end
end)

local function hyprDir()
  local base = noctalia.getenv("XDG_CONFIG_HOME")
  if base == nil or base == "" then base = "~/.config" end
  return noctalia.expandPath(base .. "/hypr")
end

local function targetPath()
  local raw = noctalia.getConfig("config_path")
  if type(raw) ~= "string" or util.trim(raw) == "" then
    raw = "~/.config/hypr/hyprmodoro.lua"
  end
  return noctalia.expandPath(util.trim(raw))
end

local function formatOf(path)
  return path:match("%.conf$") and "conf" or "lua"
end

local function mainConfigPath(format)
  return hyprDir() .. (format == "conf" and "/hyprland.conf" or "/hyprland.lua")
end

local function includeLine(path, format)
  if format == "conf" then
    return "source = " .. path
  end
  local prefix = hyprDir() .. "/"
  if path:sub(1, #prefix) == prefix then
    local rel = path:sub(#prefix + 1):gsub("%.lua$", "")
    return 'require("' .. rel .. '")'
  end
  return 'require("' .. path .. '")'
end

local LUA_HEADER = [[
-- Generated by the Noctalia "Hyprmodoro" plugin. DO NOT EDIT.
-- Every change here is overwritten. Edit in Noctalia:
--   Settings -> Plugins -> Hyprmodoro
--
-- Link this file from your main config (once):
--   require("hyprmodoro")
]]

local CONF_HEADER = [[
# Generated by the Noctalia "Hyprmodoro" plugin. DO NOT EDIT.
# Every change here is overwritten. Edit in Noctalia:
#   Settings -> Plugins -> Hyprmodoro
#
# Link this file from your main config (once):
#   source = ~/.config/hypr/hyprmodoro.conf
]]

local ACCENT_PROLOGUE = [==[
-- Border color: a high-contrast standout derived from hyprtoolkit's accent
-- (complementary hue, fully saturated, mid lightness), else fall back to red.
local function read_accent_secondary()
  local home = os.getenv("HOME") or ""
  local f = io.open(home .. "/.config/hypr/hyprtoolkit.conf", "r")
  if not f then
    return nil
  end
  local hex
  for line in f:lines() do
    local v = line:match("^%s*accent%s*=%s*(%S+)")
    if v then
      hex = v:match("(%x%x%x%x%x%x%x%x)") or v:match("(%x%x%x%x%x%x)")
      break
    end
  end
  f:close()
  return hex
end
local function standout(hex)
  local r = tonumber(hex:sub(1, 2), 16) / 255
  local g = tonumber(hex:sub(3, 4), 16) / 255
  local b = tonumber(hex:sub(5, 6), 16) / 255
  local a = #hex == 8 and hex:sub(7, 8) or "ff"
  local max, min = math.max(r, g, b), math.min(r, g, b)
  local d = max - min
  local h = 0
  if d > 0 then
    if max == r then
      h = (g - b) / d + (g < b and 6 or 0)
    elseif max == g then
      h = (b - r) / d + 2
    else
      h = (r - g) / d + 4
    end
    h = h / 6
  end
  h = (h + 0.5) % 1 -- complementary hue for maximum contrast
  local s, l = 1, 0.55 -- crank saturation, punchy mid lightness
  local function hue2rgb(p, q, t)
    if t < 0 then
      t = t + 1
    end
    if t > 1 then
      t = t - 1
    end
    if t < 1 / 6 then
      return p + (q - p) * 6 * t
    end
    if t < 1 / 2 then
      return q
    end
    if t < 2 / 3 then
      return p + (q - p) * (2 / 3 - t) * 6
    end
    return p
  end
  local nr, ng, nb = l, l, l
  if s > 0 then
    local q = l < 0.5 and l * (1 + s) or l + s - l * s
    local p = 2 * l - q
    nr = hue2rgb(p, q, h + 1 / 3)
    ng = hue2rgb(p, q, h)
    nb = hue2rgb(p, q, h - 1 / 3)
  end
  return string.format(
    "rgba(%02x%02x%02x%s)",
    math.floor(nr * 255 + 0.5),
    math.floor(ng * 255 + 0.5),
    math.floor(nb * 255 + 0.5),
    a
  )
end
local accent = read_accent_secondary()
local border_color = accent and standout(accent) or "rgba(ff0000ff)"
]==]

local function generateLua()
  local body = schema.body(noctalia.getConfig, true, "        ")
  if body == "" then return nil end

  local prologue = ""
  if schema.usesDerivedColor(noctalia.getConfig) then
    prologue = ACCENT_PROLOGUE
  end

  return table.concat({
    LUA_HEADER,
    prologue,
    "local ok, err = pcall(function()",
    "  hl.config({",
    "    plugin = {",
    "      hyprmodoro = {",
    body,
    "      },",
    "    },",
    "  })",
    "end)",
    "",
    "if not ok then",
    '  print("[hyprmodoro] config not applied yet: " .. tostring(err))',
    "end",
    "",
  }, "\n")
end

local function generateConf()
  local lines = { CONF_HEADER }
  for _, kv in ipairs(schema.legacyPairs(noctalia.getConfig)) do
    table.insert(lines, "plugin:hyprmodoro:" .. kv[1] .. " = " .. kv[2])
  end
  if #lines == 1 then return nil end
  table.insert(lines, "")
  return table.concat(lines, "\n")
end

local function writeAtomic(path, contents)
  local dir = util.dirname(path)
  local ok, err = noctalia.mkdirAll(dir)
  if not ok then return false, err end

  local tmp = path .. ".tmp"
  ok, err = noctalia.writeFile(tmp, contents)
  if not ok then return false, err end

  ok, err = noctalia.renameFile(tmp, path)
  if not ok then
    noctalia.removeFile(tmp)
    return false, err
  end
  return true, nil
end

local function commit(contents, path)
  if contents == lastWritten then
    dirty = false
    return
  end
  local ok, err = writeAtomic(path, contents)
  if ok then
    lastWritten = contents
    dirty = false
    noctalia.state.set("hm.error", "")
  else
    noctalia.notifyError(
      noctalia.tr("title"),
      noctalia.tr("err.write_failed", { path = path })
    )
    noctalia.log("hyprmodoro writer: " .. tostring(err))
  end
end

local probing = false

function probeConfigType()
  if probing or hypr.configType ~= "unknown" then return end
  probing = true
  noctalia.runAsync('hyprctl eval "return true"', function(res)
    probing = false
    local out = (res.stdout or ""):lower()
    if out:find("only supported with the lua config", 1, true) then
      hypr.configType = "legacy"
    elseif res.exitCode == 0 then
      hypr.configType = "lua"
    end
  end, 4000)
end

local function write(force)
  if noctalia.getConfig("manage_config_file") == false then
    dirty = false
    return
  end

  local path = targetPath()
  local format = formatOf(path)

  if format == "conf" then
    local contents = generateConf()
    if contents == nil then dirty = false return end
    hypr.setConfigLegacy(schema.legacyPairs(noctalia.getConfig), function() end)
    commit(contents, path)
    return
  end

  local contents = generateLua()
  if contents == nil then dirty = false return end

  if hypr.configType == "unknown" then
    probeConfigType()
    deadline = noctalia.nowMs() + 1000
    return
  end

  if hypr.configType == "legacy" then
    noctalia.log("hyprmodoro writer: hyprlang config detected but config_path is .lua; "
      .. "the file will be written but never read. Set config_path to a .conf path.")
    commit(contents, path)
    return
  end

  local compact = schema.body(noctalia.getConfig, false, "", true)
  hypr.setConfigLua(compact, function(ok, message)
    if not ok then
      noctalia.notifyError(noctalia.tr("title"), noctalia.tr("err.invalid_config", { message = message }))
      noctalia.log("hyprmodoro writer: eval rejected config: " .. tostring(message))
      dirty = false
      return
    end
    commit(contents, path)
  end)
end

local function safeToWrite()
  if pendingForce then return true end
  if noctalia.getConfig("defer_writes_while_running") == false then return true end
  local state = noctalia.state.get("hm.state")
  return state == nil or state == "STOPPED" or state == "FINISHED"
end

local function link(onDone)
  local path = targetPath()
  local format = formatOf(path)
  local main = mainConfigPath(format)
  local line = includeLine(path, format)

  local existing = noctalia.readFile(main)
  if type(existing) ~= "string" then
    onDone(false, noctalia.tr("err.link_failed"))
    return
  end

  if existing:find(line, 1, true) ~= nil then
    onDone(true, noctalia.tr("err.already_linked"))
    return
  end

  local stamp = noctalia.formatTime("%Y%m%d-%H%M%S")
  local ok, err = noctalia.writeFile(main .. ".bak-" .. stamp, existing)
  if not ok then
    noctalia.log("hyprmodoro writer: backup failed: " .. tostring(err))
    onDone(false, noctalia.tr("err.link_failed"))
    return
  end

  local comment = format == "conf" and "#" or "--"
  local appended = existing
  if appended:sub(-1) ~= "\n" then appended = appended .. "\n" end
  appended = appended .. "\n" .. comment .. " Added by the Noctalia Hyprmodoro plugin\n" .. line .. "\n"

  ok, err = noctalia.writeFile(main, appended)
  if not ok then
    noctalia.log("hyprmodoro writer: link write failed: " .. tostring(err))
    onDone(false, noctalia.tr("err.link_failed"))
    return
  end

  local module = line:match('require%("(.-)"%)') or path
  onDone(true, noctalia.tr("err.linked", { module = module }))
end

local function arm(force)
  dirty = true
  if force then pendingForce = true end
  deadline = noctalia.nowMs() + DEBOUNCE_MS
end

function onConfigChanged()
  arm(false)
end

function update()
  if not dirty then return end
  if noctalia.nowMs() < deadline then return end

  if hypr.configType == "unknown" then
    probeConfigType()
    deadline = noctalia.nowMs() + 500
    return
  end

  if not safeToWrite() then
    deadline = noctalia.nowMs() + 2000
    return
  end
  local force = pendingForce
  pendingForce = false
  write(force)
end

function onIpc(event, _payload)
  local verb = tostring(event or ""):lower()
  if verb == "save" then
    pendingForce = true
    dirty = true
    deadline = 0
  elseif verb == "link" then
    link(function(ok, message)
      if ok then
        noctalia.notify(noctalia.tr("title"), message)
      else
        noctalia.notifyError(noctalia.tr("title"), message)
      end
      noctalia.state.set("hm.link_result", message)
    end)
  elseif verb == "reload" then
    hypr.reload(nil)
  end
end

noctalia.state.watch("hm.link_request", function(value)
  if value ~= true then return end
  noctalia.state.set("hm.link_request", false)
  link(function(ok, message)
    if ok then
      noctalia.notify(noctalia.tr("title"), message)
    else
      noctalia.notifyError(noctalia.tr("title"), message)
    end
    noctalia.state.set("hm.link_result", message)
  end)
end)

noctalia.state.watch("hm.save_request", function(value)
  if value ~= true then return end
  noctalia.state.set("hm.save_request", false)
  arm(true)
  deadline = 0
end)

function onEnable()

  arm(true)
end

noctalia.setUpdateInterval(250)
noctalia.state.set("hm.link_result", "")
arm(false)
