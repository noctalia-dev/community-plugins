/* Noctalia DNF Updater - Passwordless Update Policy
 *
 * Grants authorization for the dedicated dnf-updater-helper script
 * to active local users in the wheel or sudo group.
 *
 * The helper strictly restricts operations to 'upgrade' with validated
 * exclusions, preventing arbitrary command execution as root.
 *
 * Install:
 *   curl -fsSL https://raw.githubusercontent.com/strob3/dnf-updater/main/scripts/install.sh | sudo bash
 *   (or locally: sudo ./scripts/install.sh)
 *
 * Remove:
 *   sudo ./scripts/install.sh --uninstall
 */
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/local/bin/dnf-updater-helper" &&
        subject.active == true && subject.local == true &&
        (subject.isInGroup("wheel") || subject.isInGroup("sudo"))) {
        return polkit.Result.YES;
    }

    return polkit.Result.NOT_HANDLED;
});
