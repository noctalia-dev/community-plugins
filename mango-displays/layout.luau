--!nonstrict
-- Shared monitor logic for the panel and the watcher service.
--
-- Control goes through mango: `mmsg dispatch` applies and toggles, monitorrule
-- lines in monitors.conf persist, and reload_config does both at once. The one
-- thing mango cannot answer is which modes a display supports - `mmsg get
-- all-monitors` reports the current mode only, and sysfs lists resolutions
-- without refresh rates - so `wlr-randr --json` stays as a read-only capability
-- query. Mango's own docs point at it for make/model/serial too.

local HEADER = "# Generated by the Noctalia display plugin. Rewritten when the layout changes."
local QUERY_TIMEOUT_MS = 5000

-- wlroots transform names in the order mango's rr parameter numbers them.
local TRANSFORMS = {
  normal = 0,
  ["90"] = 1,
  ["180"] = 2,
  ["270"] = 3,
  flipped = 4,
  ["flipped-90"] = 5,
  ["flipped-180"] = 6,
  ["flipped-270"] = 7,
}

local M = {}

function M.shellQuote(s)
  return "'" .. tostring(s):gsub("'", "'\\''") .. "'"
end

function M.resolutionOf(mode)
  return string.format("%dx%d", mode.width, mode.height)
end

-- Refresh arrives with sub-mHz noise (60.002998); round before comparing so two
-- spellings of the same mode collapse into one entry.
function M.roundHz(hz)
  return math.floor(hz * 1000 + 0.5) / 1000
end

function M.rulesPath()
  local configured = noctalia.getConfig("monitor_rules_path")
  if type(configured) ~= "string" or configured == "" then
    return nil
  end
  return noctalia.expandPath(configured)
end

-- ── Reading current state ──────────────────────────────────────────────────

function M.parseOutputs(raw)
  local decoded, err = noctalia.json.decode(raw)
  if type(decoded) ~= "table" then
    noctalia.log("display: cannot parse wlr-randr output: " .. tostring(err))
    return {}
  end

  local parsed = {}
  for _, entry in ipairs(decoded) do
    -- Disabled outputs are listed too, otherwise there is no way back on.
    if type(entry.modes) == "table" and #entry.modes > 0 then
      local current = nil
      for _, mode in ipairs(entry.modes) do
        if mode.current then
          current = mode
          break
        end
      end
      table.insert(parsed, {
        name = entry.name,
        enabled = entry.enabled == true,
        make = entry.make or "",
        model = entry.model or "",
        serial = entry.serial or "",
        scale = tonumber(entry.scale) or 1.0,
        x = entry.position and entry.position.x or 0,
        y = entry.position and entry.position.y or 0,
        transform = entry.transform or "normal",
        adaptiveSync = entry.adaptive_sync == true,
        modes = entry.modes,
        currentMode = current,
      })
    end
  end
  return parsed
end

function M.query(onDone)
  noctalia.runAsync("wlr-randr --json", function(result)
    onDone(result.exitCode == 0 and M.parseOutputs(result.stdout) or nil)
  end, QUERY_TIMEOUT_MS)
end

-- ── mango control ──────────────────────────────────────────────────────────

-- A monitor_spec for mmsg dispatch. Identity beats the connector name, which
-- moves between boots and between USB-C ports.
function M.monitorSpec(output)
  if output.make ~= "" and output.model ~= "" then
    local spec = "make:" .. output.make .. "&&model:" .. output.model
    if output.serial ~= "" then
      spec = spec .. "&&serial:" .. output.serial
    end
    return spec
  end
  return output.name
end

function M.dispatch(command, onDone)
  return noctalia.runAsync("mmsg dispatch " .. M.shellQuote(command), onDone, QUERY_TIMEOUT_MS)
end

function M.setMonitorEnabled(output, on, onDone)
  local verb = on and "enable_monitor" or "disable_monitor"
  return M.dispatch(verb .. "," .. M.monitorSpec(output), onDone)
end

-- ── Mirroring ──────────────────────────────────────────────────────────────

-- The pair is chosen in the panel; this is only the default source, which is
-- the built-in panel where there is one and the first lit output otherwise.
function M.mirrorSource(outputs)
  local fallback = nil
  for _, output in ipairs(outputs) do
    if output.enabled then
      if output.name:match("^eDP") or output.name:match("^LVDS") or output.name:match("^DSI") then
        return output.name
      end
      fallback = fallback or output.name
    end
  end
  return fallback
end

-- ── monitorrule persistence ────────────────────────────────────────────────

local function ruleFor(output, originX, originY)
  local fields = {}
  if output.make ~= "" and output.model ~= "" then
    table.insert(fields, "make:" .. output.make)
    table.insert(fields, "model:" .. output.model)
    if output.serial ~= "" then
      table.insert(fields, "serial:" .. output.serial)
    end
  else
    -- name is a regex, so anchor it or eDP-1 would also match eDP-11.
    table.insert(fields, "name:^" .. output.name .. "$")
  end

  if not output.enabled then
    table.insert(fields, "disable:1")
    return "monitorrule=" .. table.concat(fields, ",")
  end

  local mode = output.currentMode
  if mode == nil then
    return nil
  end
  table.insert(fields, "disable:0")
  table.insert(fields, "width:" .. mode.width)
  table.insert(fields, "height:" .. mode.height)
  table.insert(fields, string.format("refresh:%.3f", M.roundHz(mode.refresh)))
  table.insert(fields, "x:" .. (output.x - originX))
  table.insert(fields, "y:" .. (output.y - originY))
  table.insert(fields, string.format("scale:%.4f", output.scale))
  table.insert(fields, "rr:" .. (TRANSFORMS[output.transform] or 0))
  table.insert(fields, "vrr:" .. (output.adaptiveSync and 1 or 0))
  return "monitorrule=" .. table.concat(fields, ",")
end

-- Rules are keyed on identity rather than grouped per output set, because that
-- is all mango offers. Re-read what is already there so a display that is not
-- plugged in right now keeps its rule.
local function readRules(path)
  local rules = {}
  if not noctalia.fileExists(path) then
    return rules
  end
  local raw = noctalia.readFile(path)
  if raw == nil then
    return rules
  end
  for line in (raw .. "\n"):gmatch("(.-)\n") do
    if line:match("^monitorrule=") then
      -- Key on the identity fields so a rewrite replaces rather than duplicates.
      local key = line:match("^monitorrule=(.-),disable:") or line:match("^monitorrule=(.*)$")
      rules[key] = line
    end
  end
  return rules
end

-- Returns ok, error, changed. onApplied fires once mango has reloaded, so a
-- caller can re-read state that the reload changed.
function M.save(outputs, onApplied)
  local path = M.rulesPath()
  if path == nil then
    return false, "no monitor rules path configured", false
  end

  -- Rebase on the layout's top-left: XWayland maps clicks into a leading gap,
  -- and mishandles negative coordinates outright.
  local lit = 0
  local originX, originY = 0, 0
  for _, output in ipairs(outputs) do
    if output.enabled then
      lit += 1
      if lit == 1 or output.x < originX then originX = output.x end
      if lit == 1 or output.y < originY then originY = output.y end
    end
  end
  -- A config where every monitor is disabled cannot be undone from this machine.
  if lit == 0 then
    return false, "refusing to save a config with every monitor disabled", false
  end

  local rules = readRules(path)
  for _, output in ipairs(outputs) do
    local rule = ruleFor(output, originX, originY)
    if rule ~= nil then
      local key = rule:match("^monitorrule=(.-),disable:") or rule
      rules[key] = rule
    end
  end

  local keys = {}
  for key in pairs(rules) do
    table.insert(keys, key)
  end
  table.sort(keys)

  local lines = { HEADER }
  for _, key in ipairs(keys) do
    table.insert(lines, rules[key])
  end
  local body = table.concat(lines, "\n") .. "\n"

  if noctalia.fileExists(path) and noctalia.readFile(path) == body then
    if onApplied ~= nil then
      onApplied()
    end
    return true, nil, false
  end

  local dir = path:match("^(.*)/[^/]+$")
  if dir ~= nil then
    noctalia.mkdirAll(dir)
  end
  local ok, err = noctalia.writeFile(path, body)
  if not ok then
    return false, err, false
  end

  M.dispatch("reload_config", function(result)
    if result.exitCode ~= 0 then
      noctalia.log("display: reload_config failed: " .. noctalia.string.trim(result.stderr))
    end
    if onApplied ~= nil then
      onApplied()
    end
  end)
  return true, nil, true
end

return M
